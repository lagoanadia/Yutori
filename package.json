{
  "name": "yutori-web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "db:migrar:local": "wrangler d1 migrations apply yutori --local",
    "db:ejemplo": "wrangler d1 execute yutori --local --file scripts/ejemplo-local.sql",
    "db:migrar:remoto": "wrangler d1 migrations apply yutori --remote",
    "textos:guardar": "node scripts/textos.mjs guardar",
    "textos:comparar": "node scripts/textos.mjs comparar",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "astro": "^7.3.8",
    "jose": "^6.2.12",
    "wrangler": "^4.150.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "playwright": "^1.64.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
