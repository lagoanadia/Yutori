---
import '@fontsource/playfair-display/600.css';
import '@fontsource/playfair-display/700.css';
import '@fontsource/nunito-sans/400.css';
import '@fontsource/nunito-sans/700.css';
import '@fontsource/parisienne/400.css';
import '../styles/global.css';
import Mariposa from '../components/Mariposa.astro';
import { negocio, whatsappUrl } from '../data/yutori';

interface Props {
  titulo: string;
  descripcion?: string;
  /** Páginas privadas (enlace de tallerista): nunca en Google, aunque la web se indexe. */
  noindex?: boolean;
}

const { titulo, noindex = false, descripcion ='Talleres creativos en el centro de A Coruña: clases de acuarela, ganchillo, costura y bordado, talleres mensuales, talleres privados y bonos regalo.' } = Astro.props;

const menu = [
  { href: '/clases', texto: 'Clases' },
  { href: '/talleres', texto: 'Talleres' },
  { href: '/privados', texto: 'Privados' },
  { href: '/bonos', texto: 'Bonos regalo' },
  { href: '/espacio', texto: 'El espacio' },
];
const actual = Astro.url.pathname.replace(/\/$/, '');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{titulo === 'Inicio' ? `${negocio.nombre} ${negocio.subtitulo} · Talleres creativos en A Coruña` : `${titulo} · ${negocio.nombre} ${negocio.subtitulo}`}</title>
    <meta name="description" content={descripcion} />
    {(noindex || !negocio.indexar) && <meta name="robots" content="noindex, nofollow" />}
    <slot name="head" />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <header class="cabecera">
      <div class="contenedor cabecera__fila">
        <a class="marca" href="/" aria-label="Yutori Espacio Creativo, inicio">
          <Mariposa size={64} />
          <span>
            <span class="marca__nombre">{negocio.nombre}</span>
            <span class="marca__sub">{negocio.subtitulo}</span>
          </span>
        </a>
        <nav class="menu-escritorio" aria-label="Principal">
          {menu.map((m) => <a href={m.href} aria-current={actual === m.href ? 'page' : undefined}>{m.texto}</a>)}
        </nav>
        <details class="menu-movil">
          <summary aria-label="Abrir menú">Menú</summary>
          <nav aria-label="Principal (móvil)">
            {menu.map((m) => <a href={m.href} aria-current={actual === m.href ? 'page' : undefined}>{m.texto}</a>)}
            <a href="/colabora">Da un taller en Yutori</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="pie">
      <div class="contenedor pie__rejilla">
        <div>
          <p class="pie__marca">{negocio.nombre} <span class="script">{negocio.subtitulo}</span></p>
          <p>{negocio.direccion}<br />{negocio.ciudad}</p>
        </div>
        <div>
          <p><strong>Contacto</strong></p>
          <p>
            <a href={`mailto:${negocio.email}`}>{negocio.email}</a><br />
            <a href={negocio.instagram} rel="noopener" target="_blank">Instagram {negocio.instagramUsuario}</a><br />
            <a href={whatsappUrl()}>WhatsApp</a>
          </p>
        </div>
        <div>
          <p><strong>Yutori</strong></p>
          <p>
            <a href="/colabora">Da un taller en Yutori</a><br />
            <a href="/condiciones">Reservas y cancelaciones</a><br />
            <a href="/aviso-legal">Aviso legal</a> · <a href="/privacidad">Privacidad</a> · <a href="/cookies">Cookies</a>
          </p>
        </div>
      </div>
    </footer>

    <a class="whatsapp" href={whatsappUrl()} aria-label="Escríbenos por WhatsApp">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.7 15l-1.3 4.8 4.9-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-2.9.8.8-2.8-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 2s.8 2.3.9 2.5c.1.2 1.6 2.5 4 3.5 1.5.6 2.1.7 2.8.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.2-.2-.2-.5-.3Z"/></svg>
    </a>
  </body>
</html>

<style>
  .saltar { position: absolute; left: -9999px; }
  .saltar:focus { left: 16px; top: 16px; background: #fff; padding: 8px 12px; z-index: 10; }

  .cabecera {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--crema) 92%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--borde);
  }
  .cabecera__fila { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 72px; }
  .marca { display: flex; align-items: center; gap: 10px; color: var(--verde); text-decoration: none; }
  .marca__nombre { display: block; font-family: var(--serif); font-size: 1.5rem; font-weight: 700; line-height: 1; }
  .marca__sub { display: block; font-family: var(--script); font-size: 1.15rem; line-height: 1.1; }

  .menu-escritorio { display: none; gap: 24px; }
  .menu-escritorio a, .menu-movil a { color: var(--tinta); text-decoration: none; font-weight: 700; }
  .menu-escritorio a[aria-current='page'], .menu-movil a[aria-current='page'] { color: var(--verde); text-decoration: underline; text-underline-offset: 6px; }

  .menu-movil summary {
    list-style: none;
    cursor: pointer;
    font-weight: 700;
    color: var(--verde);
    border: 2px solid var(--verde);
    border-radius: 999px;
    padding: 8px 18px;
  }
  .menu-movil summary::-webkit-details-marker { display: none; }
  .menu-movil nav {
    position: absolute;
    right: 16px;
    left: 16px;
    top: 76px;
    display: grid;
    gap: 4px;
    background: var(--crema-claro);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    box-shadow: var(--sombra);
    padding: 12px;
  }
  .menu-movil nav a { padding: 12px; border-radius: 10px; }
  .menu-movil nav a:hover { background: var(--salvia-suave); }

  @media (min-width: 860px) {
    .menu-escritorio { display: flex; }
    .menu-movil { display: none; }
  }

  .pie { background: var(--verde); color: #f6f1e4; padding: 48px 0 96px; margin-top: 48px; }
  .pie a { color: #fff; }
  .pie__rejilla { display: grid; gap: 24px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .pie__marca { font-family: var(--serif); font-size: 1.6rem; }
  .pie .script { color: #f6f1e4; font-size: 1.2em; }

  .whatsapp {
    position: fixed;
    right: 16px;
    bottom: 16px;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--verde);
    color: #fff;
    box-shadow: var(--sombra);
    z-index: 6;
  }
</style>
