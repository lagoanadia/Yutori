---
import '../styles/global.css';
import Fuentes from '../components/Fuentes.astro';
import Mariposa from '../components/Mariposa.astro';
import { env } from 'cloudflare:workers';
import { negocio } from '../data/yutori';

interface Props {
  titulo: string;
  descripcion?: string;
  /** Páginas privadas (enlace de tallerista): nunca en Google, aunque la web se indexe. */
  noindex?: boolean;
}

const { titulo, noindex = false, descripcion ='Talleres creativos en el centro de A Coruña: clases de acuarela, ganchillo, costura y bordado, talleres mensuales, talleres privados y bonos regalo.' } = Astro.props;

const menu = [
  { href: '/talleres', texto: 'Talleres' },
  { href: '/clases', texto: 'Clases Semanales' },
  { href: '/privados', texto: 'Talleres Privados' },
  { href: '/bonos', texto: 'Bonos Regalo' },
  { href: '/espacio', texto: 'El Espacio' },
  { href: '/colabora', texto: 'Imparte tu Taller' },
];
const actual = Astro.url.pathname.replace(/\/$/, '');
// Móvil: barra fija abajo (al alcance del pulgar) y «Más» con el resto, que se abre desde abajo.
const barra = [
  { href: '/', texto: 'Inicio', icono: 'M4 11 12 4l8 7v9h-5v-6H9v6H4z' },
  { href: '/talleres', texto: 'Talleres', icono: 'M4 5h16v15H4zM4 10h16M9 3v4M15 3v4' },
  { href: '/clases', texto: 'Clases', icono: 'M12 4a8 8 0 1 0 0 16 8 8 0 0 0 0-16zM4.5 9.5c4 1 11 1 15 0M4.5 14.5c4-1 11-1 15 0M12 4c-3 3-3 13 0 16M12 4c3 3 3 13 0 16' },
  { href: '/bonos', texto: 'Bonos', icono: 'M3.5 9h17v11.5h-17zM2.5 9h19M12 9v11.5M12 9c-1.8-4.5-6.5-4.8-6.5-2.2C5.5 9 12 9 12 9Zm0 0c1.8-4.5 6.5-4.8 6.5-2.2C18.5 9 12 9 12 9Z' },
];
const masMenu = [
  { href: '/privados', texto: 'Talleres Privados', icono: 'M9 4a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7zM2.5 20c0-3.6 2.9-5.5 6.5-5.5s6.5 1.9 6.5 5.5M16 4.6a3.2 3.2 0 0 1 0 6.3M18 14.8c2 .6 3.5 2.2 3.5 5.2' },
  { href: '/espacio', texto: 'El Espacio', icono: 'M12 21s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12zM12 6.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z' },
  { href: '/colabora', texto: 'Imparte tu Taller', icono: 'M5 19 15.5 8.5M14 5l5 5M4 20l2.5-.5L5 18zM13 6l2-2 5 5-2 2' },
  { href: '/condiciones', texto: 'Reservas y cancelaciones', icono: 'M6 3h9l4 4v14H6zM14 3v5h5M9 13h7M9 17h5' },
];
const dentro = (href: string) => (href === '/' ? actual === '' : actual === href || actual.startsWith(href + '/'));
const tituloCompleto = titulo === 'Inicio'
  ? `${negocio.nombre} ${negocio.subtitulo} · Talleres creativos en A Coruña`
  : `${titulo} · ${negocio.nombre} ${negocio.subtitulo}`;
const sitio = env.SITIO_URL || Astro.url.origin;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Fuentes />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    {(noindex || !negocio.indexar) && <meta name="robots" content="noindex, nofollow" />}
    {negocio.indexar && !noindex && <link rel="canonical" href={new URL(Astro.url.pathname, sitio).href} />}
    <!-- Vista previa al compartir el enlace (WhatsApp, Instagram, Facebook…) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${negocio.nombre} ${negocio.subtitulo}`} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={new URL('/og.jpg', sitio).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {env.CF_ANALYTICS_TOKEN && !noindex && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: env.CF_ANALYTICS_TOKEN })}></script>
    )}
    <slot name="head" />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <header class="cabecera">
      <div class="contenedor-amplio cabecera__fila">
        <a class="marca" href="/" aria-label="Yutori Espacio Creativo, inicio">
          <Mariposa size={64} />
          <span>
            <span class="marca__nombre">{negocio.nombre}</span>
            <span class="marca__sub">{negocio.subtitulo}</span>
          </span>
        </a>
        <nav class="menu-escritorio" aria-label="Principal">
          {menu.map((m) => <a href={m.href} aria-current={actual === m.href ? 'page' : undefined}>{m.texto}</a>)}
        </nav>
        <details class="menu-movil">
          <summary aria-label="Abrir menú">
            <svg class="menu-movil__icono" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path class="raya raya--1" d="M4 7h16" /><path class="raya raya--2" d="M4 12h16" /><path class="raya raya--3" d="M4 17h16" /></svg>
            Menú
          </summary>
          <nav aria-label="Principal (móvil)">
            {menu.map((m) => <a href={m.href} aria-current={actual === m.href ? 'page' : undefined}>{m.texto}</a>)}
          </nav>
        </details>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="pie">
      <span class="mariposa-marca pie__mariposa" aria-hidden="true"></span>
      <div class="contenedor-amplio pie__rejilla">
        <div>
          <p class="pie__marca">{negocio.nombre} {negocio.subtitulo}</p>
          <p>{negocio.direccion}<br />{negocio.ciudad}</p>
        </div>
        <div>
          <p><strong>Contacto</strong></p>
          <ul class="pie__contacto">
            <li>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" /></svg>
              <a href={negocio.instagram} rel="noopener" target="_blank">{negocio.instagramUsuario}</a>
            </li>
          </ul>
        </div>
        <div>
          <p><strong>Yutori</strong></p>
          <p>
            <a href="/condiciones">Reservas y cancelaciones</a><br />
            <a href="/aviso-legal">Aviso legal</a> · <a href="/privacidad">Privacidad</a> · <a href="/cookies">Cookies</a>
          </p>
        </div>
      </div>
    </footer>

    <nav class="barra-movil" aria-label="Principal (móvil)">
      {barra.map((m) => (
        <a href={m.href} aria-current={dentro(m.href) ? 'page' : undefined}>
          <span class="barra-movil__ico"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d={m.icono} /></svg></span>
          {m.texto}
        </a>
      ))}
      <button type="button" class:list={['barra-movil__mas', { actual: masMenu.some((m) => dentro(m.href)) }]} popovertarget="hoja-mas">
        <span class="barra-movil__ico"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M5 12h.01M12 12h.01M19 12h.01" /></svg></span>
        Más
      </button>
    </nav>
    <div id="hoja-mas" popover class="hoja-mas" aria-label="Más">
      <span class="hoja-mas__asa" aria-hidden="true"></span>
      {masMenu.map((m) => (
        <a href={m.href} aria-current={dentro(m.href) ? 'page' : undefined}>
          <span class="hoja-mas__ico"><svg viewBox="0 0 24 24" width="21" height="21" aria-hidden="true"><path d={m.icono} /></svg></span>
          {m.texto}<span class="hoja-mas__flecha" aria-hidden="true">›</span>
        </a>
      ))}
      <a href={negocio.instagram} rel="noopener" target="_blank">
        <span class="hoja-mas__ico"><svg viewBox="0 0 24 24" width="21" height="21" aria-hidden="true"><path d="M3 3h18v18H3zM12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM17.5 6.5h.01" /></svg></span>
        {negocio.instagramUsuario}<span class="hoja-mas__flecha" aria-hidden="true">›</span>
      </a>
      <p class="hoja-mas__pie">{negocio.direccion}, {negocio.ciudad}<br /><a href="/aviso-legal">Aviso legal</a> · <a href="/privacidad">Privacidad</a> · <a href="/cookies">Cookies</a></p>
    </div>

    <script is:inline>
      // Menú móvil: se cierra al pulsar fuera, con Esc o al elegir un enlace. Sin JavaScript funciona igual (details).
      (() => {
        const menu = document.querySelector('.menu-movil');
        if (!menu) return;
        const cerrar = (devolverFoco) => {
          if (!menu.open) return;
          menu.open = false;
          if (devolverFoco) menu.querySelector('summary').focus();
        };
        document.addEventListener('click', (e) => { if (!menu.contains(e.target)) cerrar(false); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') cerrar(true); });
        menu.querySelectorAll('nav a').forEach((a) => a.addEventListener('click', () => cerrar(false)));
      })();
    </script>
      <script>import '../scripts/calendario';</script>
  </body>
</html>

<style>
  .saltar { position: absolute; left: -9999px; }
  .saltar:focus { left: 16px; top: 16px; background: #fff; padding: 8px 12px; z-index: 10; }

  /* Cabecera ligera: papel translúcido que deja ver lo que pasa por debajo */
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--crema) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--borde) 70%, transparent);
  }
  .cabecera__fila { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 68px; }
  .marca { display: flex; align-items: center; gap: 10px; color: var(--verde-profundo); text-decoration: none; }
  .marca :global(img) { width: 54px; height: auto; }
  .marca__nombre { display: block; font-family: var(--serif); font-size: 1.5rem; font-weight: 500; line-height: 1; letter-spacing: -0.02em; }
  .marca__sub { display: block; font-family: var(--serif); font-style: italic; font-size: 0.92rem; line-height: 1.2; color: var(--verde); }

  .menu-escritorio { display: none; align-items: center; gap: 2px; }
  .menu-escritorio a, .menu-movil a { color: var(--tinta); text-decoration: none; font-weight: 500; }
  .menu-escritorio a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 12px;
    font-size: 0.96rem;
  }
  /* Punto bajo el enlace: aparece al pasar y se queda en la página actual */
  .menu-escritorio a::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 6px;
    width: 5px;
    height: 5px;
    margin-left: -2.5px;
    border-radius: 50%;
    background: var(--verde);
    transform: scale(0);
  }
  .menu-escritorio a:hover::after, .menu-escritorio a[aria-current='page']::after { transform: scale(1); }
  .menu-escritorio a[aria-current='page'], .menu-movil a[aria-current='page'] { color: var(--verde-profundo); font-weight: 600; }
  /* El último enlace (para talleristas) va como píldora aparte */
  .menu-escritorio a:last-child { margin-left: 12px; padding: 0 20px; border-radius: 999px; background: var(--crema-claro); box-shadow: var(--sombra-suave); }
  .menu-escritorio a:last-child::after { display: none; }
  .menu-escritorio a:last-child:hover { background: var(--verde-profundo); color: var(--crema-claro); }

  .menu-movil summary {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    font-weight: 600;
    color: var(--verde-profundo);
    background: var(--crema-claro);
    border-radius: 999px;
    padding: 8px 18px 8px 14px;
    box-shadow: var(--sombra-suave);
  }
  .menu-movil summary::-webkit-details-marker { display: none; }
  .menu-movil[open] summary { background: var(--verde-profundo); color: var(--crema-claro); }
  .menu-movil[open] .raya--2 { opacity: 0; }
  .menu-movil[open] .raya--1 { transform: translateY(5px) rotate(45deg); }
  .menu-movil[open] .raya--3 { transform: translateY(-5px) rotate(-45deg); }
  .raya { transform-box: fill-box; transform-origin: center; }
  .menu-movil nav {
    position: absolute;
    right: var(--margen);
    left: var(--margen);
    top: 76px;
    display: grid;
    gap: 2px;
    background: var(--crema-claro);
    border-radius: var(--radio-grande);
    box-shadow: 0 0 0 100vmax rgba(38, 51, 47, 0.32), var(--sombra-alta);
    padding: 12px;
  }
  .menu-movil nav a { display: flex; align-items: center; min-height: 52px; padding: 8px 16px; border-radius: 16px; font-family: var(--serif); font-size: 1.3rem; color: var(--verde-profundo); }
  .menu-movil nav a:hover { background: var(--salvia-suave); }
  .menu-movil a[aria-current='page'] { background: var(--salvia-suave); }

  @media (prefers-reduced-motion: no-preference) {
    .menu-escritorio a::after { transition: transform var(--duracion-corta) var(--curva-salida); }
    .menu-escritorio a:last-child { transition: background-color var(--duracion-corta), color var(--duracion-corta); }
    .raya { transition: transform var(--duracion-corta) var(--curva-salida), opacity var(--duracion-corta); }
    .menu-movil nav { transition: opacity var(--duracion-media) var(--curva-salida), transform var(--duracion-media) var(--curva-salida); }
    @starting-style {
      .menu-movil[open] nav { opacity: 0; transform: translateY(-8px) scale(0.98); }
    }
  }

  /* Seis apartados con nombres largos: el menú completo solo cabe en pantallas anchas. */
  @media (min-width: 1100px) {
    .menu-escritorio { display: flex; }
    .menu-movil { display: none; }
  }

  /* Pie: bloque verde que se monta sobre la página con las esquinas en curva */
  .pie {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--verde-profundo);
    color: #f3ede0;
    padding: clamp(56px, 7vw, 88px) 0 48px;
    margin-top: clamp(40px, 6vw, 80px);
    border-radius: clamp(28px, 4vw, 48px) clamp(28px, 4vw, 48px) 0 0;
    --foco: var(--crema);
  }
  .pie::before { content: ''; position: absolute; inset: 0; z-index: -1; background-image: var(--grano); opacity: 0.12; mix-blend-mode: soft-light; }
  .pie__mariposa { position: absolute; right: -60px; bottom: -70px; width: min(520px, 90vw); color: var(--salvia); opacity: 0.12; }
  .pie a { color: #fff; }
  .pie a:hover { color: var(--salvia-suave); }
  .pie__rejilla { position: relative; display: grid; gap: 24px 40px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .pie__marca { font-family: var(--serif); font-size: 1.7rem; line-height: 1.15; letter-spacing: -0.015em; }
  .pie strong { font-weight: 600; color: var(--salvia-suave); }
  .pie__contacto { list-style: none; padding: 0; margin: 0 0 1em; display: grid; gap: 8px; }
  .pie__contacto li { display: flex; align-items: center; gap: 10px; overflow-wrap: anywhere; }
  .pie__contacto svg { flex: none; }

  /* ——— Móvil (hasta 759 px): navegación de app abajo; el menú de arriba y el pie se recogen en «Más». ——— */
  .barra-movil, .hoja-mas { display: none; }
  @media (max-width: 759px) {
    .cabecera { position: relative; background: transparent; backdrop-filter: none; -webkit-backdrop-filter: none; box-shadow: none; }
    .cabecera__fila { min-height: 64px; }
    .menu-movil, .pie { display: none; }
    .marca :global(img) { width: 42px; }
    .marca__nombre { font-size: 1.3rem; }
    body { padding-bottom: calc(84px + env(safe-area-inset-bottom)); }
    .barra-movil {
      position: fixed; z-index: 40; left: 0; right: 0; bottom: 0;
      display: grid; grid-template-columns: repeat(5, 1fr);
      padding: 8px 6px calc(8px + env(safe-area-inset-bottom));
      background: color-mix(in srgb, var(--crema-claro) 94%, transparent);
      backdrop-filter: blur(14px) saturate(1.2); -webkit-backdrop-filter: blur(14px) saturate(1.2);
      border-top: 1px solid var(--borde);
    }
    .barra-movil a, .barra-movil__mas {
      display: flex; flex-direction: column; align-items: center; gap: 3px; min-height: 54px; padding: 0 2px;
      border: 0; background: none; cursor: pointer; font: inherit; font-size: 0.7rem; font-weight: 600;
      color: var(--tinta-suave); text-decoration: none;
    }
    .barra-movil svg { display: block; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
    .barra-movil__mas svg { stroke-width: 3; }
    .barra-movil__ico { padding: 2px 14px; border-radius: 999px; }
    .barra-movil a[aria-current='page'], .barra-movil__mas.actual { color: var(--verde-profundo); }
    .barra-movil a[aria-current='page'] .barra-movil__ico, .barra-movil__mas.actual .barra-movil__ico { background: var(--salvia-suave); }

    .hoja-mas {
      position: fixed; inset: auto 0 0 0; width: 100%; max-width: none; margin: 0; z-index: 50;
      padding: 6px 16px calc(28px + env(safe-area-inset-bottom)); border: 0; border-radius: 28px 28px 0 0;
      background: var(--crema-claro); box-shadow: 0 -10px 40px rgba(38, 51, 47, 0.25);
    }
    .hoja-mas:popover-open { display: block; }
    .hoja-mas::backdrop { background: rgba(38, 51, 47, 0.38); }
    .hoja-mas__asa { display: block; width: 40px; height: 5px; border-radius: 99px; background: var(--borde); margin: 4px auto 10px; }
    .hoja-mas > a { display: flex; align-items: center; gap: 14px; min-height: 64px; border-bottom: 1px solid var(--borde); color: var(--tinta); text-decoration: none; font-weight: 700; }
    .hoja-mas > a[aria-current='page'] { color: var(--verde-profundo); }
    .hoja-mas__ico { width: 40px; height: 40px; border-radius: 13px; background: var(--salvia-suave); color: var(--verde-profundo); display: grid; place-items: center; flex: none; }
    .hoja-mas__ico svg { fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
    .hoja-mas__flecha { margin-left: auto; color: var(--tinta-suave); font-size: 1.4rem; font-weight: 400; }
    .hoja-mas__pie { margin: 14px 0 0; font-size: 0.8rem; color: var(--tinta-suave); line-height: 1.6; }
    .hoja-mas__pie a { color: var(--tinta-suave); }
    @media (prefers-reduced-motion: no-preference) {
      .hoja-mas { transition: translate 280ms var(--curva-salida), display 280ms allow-discrete, overlay 280ms allow-discrete; }
      @starting-style { .hoja-mas:popover-open { translate: 0 100%; } }
      .hoja-mas:not(:popover-open) { translate: 0 100%; }
    }
  }
</style>
