---
import '@fontsource/playfair-display/600.css';
import '@fontsource/playfair-display/700.css';
import '@fontsource/nunito-sans/400.css';
import '@fontsource/nunito-sans/700.css';
import '@fontsource/parisienne/400.css';
import '../styles/global.css';
import Mariposa from '../components/Mariposa.astro';
import { env } from 'cloudflare:workers';
import { negocio } from '../data/yutori';

interface Props {
  titulo: string;
  descripcion?: string;
  /** Páginas privadas (enlace de tallerista): nunca en Google, aunque la web se indexe. */
  noindex?: boolean;
}

const { titulo, noindex = false, descripcion ='Talleres creativos en el centro de A Coruña: clases de acuarela, ganchillo, costura y bordado, talleres mensuales, talleres privados y bonos regalo.' } = Astro.props;

const menu = [
  { href: '/talleres', texto: 'Talleres' },
  { href: '/clases', texto: 'Clases Semanales' },
  { href: '/privados', texto: 'Talleres Privados' },
  { href: '/bonos', texto: 'Bonos Regalo' },
  { href: '/espacio', texto: 'El Espacio' },
  { href: '/colabora', texto: 'Imparte tu Taller' },
];
const actual = Astro.url.pathname.replace(/\/$/, '');
const tituloCompleto = titulo === 'Inicio'
  ? `${negocio.nombre} ${negocio.subtitulo} · Talleres creativos en A Coruña`
  : `${titulo} · ${negocio.nombre} ${negocio.subtitulo}`;
const sitio = env.SITIO_URL || Astro.url.origin;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    {(noindex || !negocio.indexar) && <meta name="robots" content="noindex, nofollow" />}
    {negocio.indexar && !noindex && <link rel="canonical" href={new URL(Astro.url.pathname, sitio).href} />}
    <!-- Vista previa al compartir el enlace (WhatsApp, Instagram, Facebook…) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${negocio.nombre} ${negocio.subtitulo}`} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={new URL('/og.jpg', sitio).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {env.CF_ANALYTICS_TOKEN && !noindex && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: env.CF_ANALYTICS_TOKEN })}></script>
    )}
    <slot name="head" />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <header class="cabecera">
      <div class="contenedor-amplio cabecera__fila">
        <a class="marca" href="/" aria-label="Yutori Espacio Creativo, inicio">
          <Mariposa size={64} />
          <span>
            <span class="marca__nombre">{negocio.nombre}</span>
            <span class="marca__sub">{negocio.subtitulo}</span>
          </span>
        </a>
        <nav class="menu-escritorio" aria-label="Principal">
          {menu.map((m) => <a href={m.href} aria-current={actual === m.href ? 'page' : undefined}>{m.texto}</a>)}
        </nav>
        <details class="menu-movil">
          <summary aria-label="Abrir menú">
            <svg class="menu-movil__icono" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path class="raya raya--1" d="M4 7h16" /><path class="raya raya--2" d="M4 12h16" /><path class="raya raya--3" d="M4 17h16" /></svg>
            Menú
          </summary>
          <nav aria-label="Principal (móvil)">
            {menu.map((m) => <a href={m.href} aria-current={actual === m.href ? 'page' : undefined}>{m.texto}</a>)}
          </nav>
        </details>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="pie">
      <span class="mariposa-marca pie__mariposa" aria-hidden="true"></span>
      <div class="contenedor-amplio pie__rejilla">
        <div>
          <p class="pie__marca">{negocio.nombre} {negocio.subtitulo}</p>
          <p>{negocio.direccion}<br />{negocio.ciudad}</p>
        </div>
        <div>
          <p><strong>Contacto</strong></p>
          <ul class="pie__contacto">
            <li>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
              <a href={`mailto:${negocio.email}`}>{negocio.email}</a>
            </li>
            <li>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" /></svg>
              <a href={negocio.instagram} rel="noopener" target="_blank">{negocio.instagramUsuario}</a>
            </li>
          </ul>
        </div>
        <div>
          <p><strong>Yutori</strong></p>
          <p>
            <a href="/condiciones">Reservas y cancelaciones</a><br />
            <a href="/aviso-legal">Aviso legal</a> · <a href="/privacidad">Privacidad</a> · <a href="/cookies">Cookies</a>
          </p>
        </div>
      </div>
    </footer>

    <script is:inline>
      // Menú móvil: se cierra al pulsar fuera, con Esc o al elegir un enlace. Sin JavaScript funciona igual (details).
      (() => {
        const menu = document.querySelector('.menu-movil');
        if (!menu) return;
        const cerrar = (devolverFoco) => {
          if (!menu.open) return;
          menu.open = false;
          if (devolverFoco) menu.querySelector('summary').focus();
        };
        document.addEventListener('click', (e) => { if (!menu.contains(e.target)) cerrar(false); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') cerrar(true); });
        menu.querySelectorAll('nav a').forEach((a) => a.addEventListener('click', () => cerrar(false)));
      })();
    </script>
  </body>
</html>

<style>
  .saltar { position: absolute; left: -9999px; }
  .saltar:focus { left: 16px; top: 16px; background: #fff; padding: 8px 12px; z-index: 10; }

  .cabecera {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--crema) 92%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--borde);
  }
  .cabecera__fila { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 72px; }
  .marca { display: flex; align-items: center; gap: 10px; color: var(--verde); text-decoration: none; }
  .marca__nombre { display: block; font-family: var(--serif); font-size: 1.5rem; font-weight: 700; line-height: 1; }
  .marca__sub { display: block; font-family: var(--script); font-size: 1.15rem; line-height: 1.1; }

  .menu-escritorio { display: none; gap: 4px; }
  .menu-escritorio a, .menu-movil a { color: var(--tinta); text-decoration: none; font-weight: 700; }
  .menu-escritorio a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 10px;
    font-size: 0.97rem;
  }
  /* Línea que crece desde el centro al pasar; fija en la página actual */
  .menu-escritorio a::after {
    content: '';
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    height: 2px;
    border-radius: 2px;
    background: var(--verde);
    transform: scaleX(0);
  }
  .menu-escritorio a:hover::after, .menu-escritorio a[aria-current='page']::after { transform: scaleX(1); }
  .menu-escritorio a[aria-current='page'], .menu-movil a[aria-current='page'] { color: var(--verde); }
  .menu-escritorio a:last-child { margin-left: 8px; padding-left: 18px; border-left: 1px solid var(--borde); }
  .menu-escritorio a:last-child::after { left: 18px; }
  .menu-movil a[aria-current='page'] { text-decoration: underline; text-underline-offset: 6px; }

  .menu-movil summary {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    font-weight: 700;
    color: var(--verde);
    border: 2px solid var(--verde);
    border-radius: 999px;
    padding: 8px 18px 8px 14px;
  }
  .menu-movil summary::-webkit-details-marker { display: none; }
  .menu-movil[open] summary { background: var(--verde); color: var(--crema-claro); }
  .menu-movil[open] .raya--2 { opacity: 0; }
  .menu-movil[open] .raya--1 { transform: translateY(5px) rotate(45deg); }
  .menu-movil[open] .raya--3 { transform: translateY(-5px) rotate(-45deg); }
  .raya { transform-box: fill-box; transform-origin: center; }
  .menu-movil nav {
    position: absolute;
    right: 16px;
    left: 16px;
    top: 80px;
    display: grid;
    gap: 4px;
    background: var(--crema-claro);
    border: 1px solid var(--borde);
    border-radius: var(--radio-grande);
    box-shadow: 0 0 0 100vmax rgba(36, 51, 47, 0.28), var(--sombra);
    padding: 12px;
  }
  .menu-movil nav a { display: flex; align-items: center; min-height: 48px; padding: 8px 16px; border-radius: 14px; font-size: 1.1rem; }
  .menu-movil nav a:hover { background: var(--salvia-suave); }

  @media (prefers-reduced-motion: no-preference) {
    .menu-escritorio a::after { transition: transform var(--duracion-corta) var(--curva-salida); }
    .raya { transition: transform var(--duracion-corta) var(--curva-salida), opacity var(--duracion-corta); }
    .menu-movil nav { transition: opacity var(--duracion-media) var(--curva-salida), transform var(--duracion-media) var(--curva-salida); }
    @starting-style {
      .menu-movil[open] nav { opacity: 0; transform: translateY(-8px); }
    }
  }

  /* Seis apartados con nombres largos: el menú completo solo cabe en pantallas anchas. */
  @media (min-width: 1100px) {
    .menu-escritorio { display: flex; }
    .menu-movil { display: none; }
  }

  .pie { position: relative; overflow: hidden; background: var(--verde-profundo); color: #f6f1e4; padding: 64px 0 56px; margin-top: 48px; --foco: var(--crema); }
  .pie__mariposa { position: absolute; right: -60px; bottom: -70px; width: min(520px, 90vw); color: var(--salvia); opacity: 0.14; }
  .pie__rejilla { position: relative; }
  .pie a { color: #fff; }
  .pie__rejilla { display: grid; gap: 24px 40px; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  .pie__marca { font-family: var(--serif); font-size: 1.6rem; }
  .pie__contacto { list-style: none; padding: 0; margin: 0 0 1em; display: grid; gap: 8px; }
  .pie__contacto li { display: flex; align-items: center; gap: 10px; overflow-wrap: anywhere; }
  .pie__contacto svg { flex: none; }

</style>
