---
import '../styles/global.css';
import Fuentes from '../components/Fuentes.astro';

import { pendientesDelMenu, type Pendientes } from '../lib/pendientes';

interface Props { titulo: string; ocultarTitulo?: boolean }
const { titulo, ocultarTitulo = false } = Astro.props;

const menu: { href: string; texto: string; globo?: keyof Pendientes; icono: string }[] = [
  { href: '/panel', texto: 'Hoy', icono: 'M12 3v2M12 19v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M3 12h2M19 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10z' },
  { href: '/panel/asistente', texto: 'Asistente', icono: 'M4 5h16v11H9l-5 4z' },
  { href: '/panel/talleristas', texto: 'Talleristas', globo: 'talleristas', icono: 'M12 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM4 20c0-4 3.5-6 8-6s8 2 8 6' },
  { href: '/panel/talleres', texto: 'Talleres', globo: 'talleres', icono: 'M4 5h16v14H4zM4 10h16M9 5v14' },
  { href: '/panel/reservas', texto: 'Reservas', globo: 'reservas', icono: 'M5 6h14v4a2 2 0 0 0 0 4v4H5v-4a2 2 0 0 0 0-4zM14 6v12' },
  { href: '/panel/clases', texto: 'Clases', globo: 'clases', icono: 'M5 5h14v15H5zM5 10h14M9 3v4M15 3v4' },
  { href: '/panel/solicitudes', texto: 'Privados y bonos', globo: 'solicitudes', icono: 'M4 8h16v11H4zM4 12h16M12 8v11M12 8c-3 0-4-4-1.5-4S12 8 12 8zm0 0c3 0 4-4 1.5-4S12 8 12 8z' },
];
// Barra inferior del móvil: los apartados más usados y «Más» con el resto, para ver los siete sin deslizar.
const enBarra = ['/panel', '/panel/talleres', '/panel/reservas', '/panel/clases'];
const principales = menu.filter((m) => enBarra.includes(m.href));
const secundarios = menu.filter((m) => !enBarra.includes(m.href));
const pendientes = await pendientesDelMenu();
const globo = (m: (typeof menu)[number]) => (m.globo ? pendientes[m.globo] : 0);
const globoMas = secundarios.reduce((suma, m) => suma + globo(m), 0);
const actual = Astro.url.pathname.replace(/\/$/, '');
// La sección se marca también en sus subpáginas (/panel/clases/alumna → Clases).
const seccion = menu.filter((m) => actual === m.href || actual.startsWith(m.href + '/')).pop()?.href;
const enMas = secundarios.some((m) => m.href === seccion);

// Aviso tras guardar algo (las acciones redirigen con ?ok=código).
const AVISOS: Record<string, string> = {
  guardado: 'Cambios guardados.',
  creado: 'Hueco creado. Envía el enlace privado a la tallerista.',
  publicado: 'Taller publicado.',
  desactivado: 'Taller desactivado.',
  eliminado: 'Eliminado.',
  anadido: 'Guardado. Puedes añadir otro.',
};
const ok = Astro.url.searchParams.get('ok') ?? '';
const n = Number(Astro.url.searchParams.get('n'));
const aviso = ok === 'anadidos' && n > 0 ? `${n} ${n === 1 ? 'añadido' : 'añadidos'}.` : AVISOS[ok];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <Fuentes />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{titulo} · Panel de Yutori</title>
  </head>
  <body>
    <header class="barra">
      <div class="contenedor barra__fila">
        <a class="barra__marca" href="/panel">Yutori <span>panel</span></a>
        <nav class="menu-escritorio" aria-label="Panel">
          {menu.map((m) => (
            <a href={m.href} aria-current={seccion === m.href ? 'page' : undefined}>
              {m.texto}{globo(m) > 0 && <span class="globo" aria-label={`${globo(m)} pendientes`}>{globo(m)}</span>}
            </a>
          ))}
        </nav>
        {Astro.locals.usuario === 'clave'
          ? <form method="post" action="/panel/salir"><button class="barra__salir" type="submit">Salir</button></form>
          : <span class="barra__usuario">{Astro.locals.usuario === 'local' ? 'Modo local' : Astro.locals.usuario}</span>}
      </div>
    </header>

    <nav class="menu-movil" aria-label="Panel">
      {principales.map((m) => (
        <a href={m.href} aria-current={seccion === m.href ? 'page' : undefined}>
          <span class="menu-movil__icono"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d={m.icono} /></svg>{globo(m) > 0 && <span class="globo" aria-label={`${globo(m)} pendientes`}>{globo(m)}</span>}</span>
          {m.texto}
        </a>
      ))}
      <button type="button" class:list={['menu-movil__mas', { 'menu-movil__mas--actual': enMas }]} popovertarget="menu-mas">
        <span class="menu-movil__icono"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M5 12h.01M12 12h.01M19 12h.01" /></svg>{globoMas > 0 && <span class="globo" aria-label={`${globoMas} pendientes`}>{globoMas}</span>}</span>
        Más
      </button>
      <div id="menu-mas" popover class="menu-movil__lista">
        {secundarios.map((m) => (
          <a href={m.href} aria-current={seccion === m.href ? 'page' : undefined}>
            {m.texto}{globo(m) > 0 && <span class="globo" aria-label={`${globo(m)} pendientes`}>{globo(m)}</span>}
          </a>
        ))}
      </div>
    </nav>

    <main class="contenedor panel">
      {!ocultarTitulo && <h1>{titulo}</h1>}
      {aviso && <p class="aviso-ok" role="status">{aviso}</p>}
      <slot />
    </main>
  </body>
</html>

<style is:global>
  .barra { background: var(--verde); color: #fff; position: sticky; top: 0; z-index: 5; }
  .barra__fila { display: flex; justify-content: space-between; align-items: center; min-height: 56px; gap: 12px; }
  .barra__marca { color: #fff; text-decoration: none; font-family: var(--serif); font-size: 1.4rem; font-weight: 700; }
  .barra__marca span { font-family: var(--sans); font-size: 0.85rem; font-weight: 400; opacity: 0.85; }
  .barra__usuario { font-size: 0.85rem; opacity: 0.85; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .barra__salir { background: none; border: 1px solid rgba(255, 255, 255, 0.6); color: #fff; border-radius: 999px; min-height: 44px; padding: 4px 16px; font: inherit; font-size: 0.9rem; cursor: pointer; }

  /* Globo con el número de pendientes de un apartado. */
  .globo { display: inline-block; min-width: 20px; height: 20px; padding: 0 6px; border-radius: 999px; background: var(--aviso); color: #fff; font-size: 0.75rem; font-weight: 700; line-height: 20px; text-align: center; margin-left: 6px; }

  /* Escritorio: menú compacto en la barra de arriba. */
  .menu-escritorio { display: none; }
  .menu-movil { display: grid; }

  /* Móvil: barra fija abajo con los apartados más usados y «Más». */
  .menu-movil { position: fixed; z-index: 6; left: 0; right: 0; bottom: 0; grid-template-columns: repeat(5, 1fr); background: var(--crema-claro); border-top: 1px solid var(--borde); box-shadow: 0 -4px 16px rgba(36, 51, 47, 0.08); padding-bottom: env(safe-area-inset-bottom); }
  .menu-movil a, .menu-movil__mas { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; min-height: 60px; padding: 6px 2px; color: var(--tinta-suave); text-decoration: none; font: inherit; font-size: 0.75rem; font-weight: 700; background: none; border: 0; cursor: pointer; }
  .menu-movil a[aria-current='page'], .menu-movil__mas--actual { color: var(--verde); box-shadow: inset 0 3px 0 var(--verde); }
  .menu-movil__icono { position: relative; display: inline-flex; }
  .menu-movil svg { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .menu-movil__mas svg { stroke-width: 3.2; }
  .menu-movil .globo { position: absolute; top: -6px; left: 14px; margin: 0; min-width: 18px; height: 18px; line-height: 18px; padding: 0 5px; font-size: 0.7rem; }
  .menu-movil__lista { position: fixed; inset: auto 8px calc(68px + env(safe-area-inset-bottom)) auto; margin: 0; width: min(280px, calc(100% - 16px)); padding: 6px; background: var(--crema-claro); border: 1px solid var(--borde); border-radius: var(--radio); box-shadow: var(--sombra); }
  .menu-movil__lista:not(:popover-open) { display: none; }
  .menu-movil__lista a { flex-direction: row; justify-content: flex-start; gap: 0; min-height: 52px; padding: 8px 14px; font-size: 1rem; color: var(--tinta); border-radius: 12px; }
  .menu-movil__lista a[aria-current='page'] { background: var(--salvia-suave); box-shadow: none; }
  .menu-movil__lista .globo { position: static; }

  @media (min-width: 960px) {
    .menu-movil { display: none; }
    .menu-escritorio { display: flex; gap: 2px; flex: 1; justify-content: center; }
    .menu-escritorio a { display: inline-flex; align-items: center; min-height: 44px; color: #fff; text-decoration: none; white-space: nowrap; padding: 4px 12px; border-radius: 999px; font-weight: 700; font-size: 0.95rem; }
    .menu-escritorio a[aria-current='page'] { background: var(--crema); color: var(--verde); }
    .menu-escritorio .globo { margin-left: 6px; }
  }

  .panel { padding: 20px 0 calc(88px + env(safe-area-inset-bottom)); }
  @media (min-width: 960px) { .panel { padding: 24px 0 48px; } }
  .panel h1 { font-size: 1.9rem; }
  .panel h2 { font-size: 1.35rem; margin-top: 32px; }

  .filtros { display: flex; flex-wrap: wrap; gap: 8px; margin: 8px 0 16px; }
  .filtros a { text-decoration: none; padding: 6px 14px; border-radius: 999px; border: 1px solid var(--borde); color: var(--tinta); background: var(--crema-claro); font-size: 0.95rem; }
  .filtros a[aria-current='true'] { background: var(--verde); color: #fff; border-color: var(--verde); }

  .tabla { width: 100%; border-collapse: collapse; background: var(--crema-claro); border: 1px solid var(--borde); border-radius: var(--radio); overflow: hidden; }
  .tabla th, .tabla td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--borde); vertical-align: top; }
  .tabla th { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.03em; color: var(--tinta-suave); }
  .tabla tr:last-child td { border-bottom: 0; }
  .tabla small { color: var(--tinta-suave); }
  @media (max-width: 760px) {
    .tabla, .tabla tbody, .tabla tr, .tabla td { display: block; }
    .tabla thead { display: none; }
    .tabla { background: none; border: 0; }
    .tabla tr { background: var(--crema-claro); border: 1px solid var(--borde); border-radius: var(--radio); padding: 8px 4px; margin-bottom: 12px; }
    .tabla td { border: 0; padding: 4px 12px; }
    .tabla td[data-label]::before { content: attr(data-label) ': '; font-weight: 700; color: var(--tinta-suave); font-size: 0.85rem; }
  }

  .estado { display: inline-block; font-size: 0.8rem; font-weight: 700; padding: 2px 10px; border-radius: 999px; background: var(--salvia-suave); color: var(--verde); white-space: nowrap; }
  .estado--nueva, .estado--pendiente, .estado--hueco, .estado--enviado { background: #fdebd3; color: #8a4b12; }
  .estado--confirmada, .estado--publicado, .estado--aceptada { background: #d9eedd; color: #23613a; }
  .estado--descartada, .estado--cancelada, .estado--liberada, .estado--desactivado, .estado--cerrada { background: #ece7dc; color: #6b6458; }

  /* «Editar datos»: el formulario se abre debajo de la ficha. */
  .editar { margin-top: 20px; }
  .editar > summary { list-style: none; display: inline-block; cursor: pointer; }
  .editar > summary::-webkit-details-marker { display: none; }
  .editar[open] > summary { display: none; }
  .editar > .formulario { border-top: 1px solid var(--borde); padding-top: 16px; }
  .eliminar { margin-top: 16px; }
  .acciones-lista { display: flex; flex-wrap: wrap; gap: 10px; margin: 0 0 16px; }

  .vacio { color: var(--tinta-suave); background: var(--crema-claro); border: 1px dashed var(--borde); border-radius: var(--radio); padding: 16px; }
  .ocupacion { display: inline-flex; align-items: center; gap: 8px; }
  .ocupacion__barra { width: 80px; height: 8px; border-radius: 999px; background: var(--salvia-suave); overflow: hidden; }
  .ocupacion__barra span { display: block; height: 100%; background: var(--verde); }
</style>
