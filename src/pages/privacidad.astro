---
import Base from '../layouts/Base.astro';
import LegalPendiente from '../components/LegalPendiente.astro';
---
<Base titulo="Política de privacidad">
  <LegalPendiente titulo="Política de privacidad" contenido={[
    'Responsable del tratamiento: titular de Yutori (pendiente).',
    'Para qué usamos tus datos: gestionar reservas, clases, talleres privados, bonos y propuestas de talleristas.',
    'Con quién se comparten: con la tallerista que imparte el taller que reservas (nombre y teléfono).',
    'Servicios que intervienen: alojamiento web y base de datos (Cloudflare), envío de emails (Resend) y calendario (Google).',
    'Cuánto tiempo los guardamos: plazos por definir, incluidas las propuestas de talleristas en reserva.',
    'Tus derechos: acceso, rectificación, supresión, oposición, limitación y portabilidad, escribiendo a yutori.espaciocreativo@gmail.com, y reclamación ante la AEPD.',
  ]} />
</Base>
