---
import Base from '../layouts/Base.astro';
---
<Base titulo="Página no encontrada">
  <section class="seccion">
    <div class="contenedor">
      <h1>No encontramos esta página</h1>
      <p class="intro">Puede que el enlace haya cambiado. Mira el calendario de talleres o vuelve al inicio.</p>
      <div class="botones">
        <a class="boton" href="/talleres">Ver talleres</a>
        <a class="boton boton--borde" href="/">Volver al inicio</a>
      </div>
    </div>
  </section>
</Base>
