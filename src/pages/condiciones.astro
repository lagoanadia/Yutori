---
import Base from '../layouts/Base.astro';
import { negocio, politicaTalleres, politicaClases } from '../data/yutori';
---
<Base titulo="Reservas y cancelaciones">
  <section class="seccion">
    <div class="contenedor texto-legal">
      <h1>Reservas y cancelaciones</h1>
      <h2>Talleres creativos</h2>
      <ul class="lista-politica">{politicaTalleres.map((p) => <li>{p}</li>)}</ul>
      <h2>Clases</h2>
      <ul class="lista-politica">{politicaClases.map((p) => <li>{p}</li>)}</ul>
      <p>Para cancelar o ceder tu plaza, escríbenos por <a href={`mailto:${negocio.email}`}>email</a> o por <a href={negocio.instagram} rel="noopener" target="_blank">Instagram</a>.</p>
    </div>
  </section>
</Base>

<style>
  .texto-legal { max-width: 760px; }
  .texto-legal h2 { font-size: 1.5rem; margin-top: 40px; padding-top: 20px; border-top: 1px solid color-mix(in srgb, var(--borde) 70%, transparent); }
</style>
