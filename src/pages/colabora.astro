---
import Base from '../layouts/Base.astro';
import { categorias } from '../data/yutori';
---
<Base titulo="Da un taller en Yutori" descripcion="¿Eres artesana o artista? Propón tu taller en Yutori Espacio Creativo, A Coruña.">
  <section class="seccion">
    <div class="contenedor">
      <p class="script">Familia Yutori</p>
      <h1>Da un taller en Yutori</h1>
      <p class="intro">Gracias por tu interés en formar parte de la familia Yutori. Estamos preparando la programación de talleres y clases y queremos contar con nuevas ideas. Cuéntanos la tuya y pronto tendrás noticias nuestras.</p>

      <form class="formulario" data-prototipo>
        <div class="dos-col">
          <div class="campo"><label for="nombre">Tu nombre</label><input id="nombre" name="nombre" autocomplete="name" required /></div>
          <div class="campo"><label for="marca">Nombre de marca</label><input id="marca" name="marca" /></div>
        </div>
        <div class="dos-col">
          <div class="campo"><label for="instagram">Instagram de marca</label><input id="instagram" name="instagram" placeholder="@tumarca" /></div>
          <div class="campo"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
        </div>
        <div class="campo"><label for="tel">Teléfono</label><input id="tel" name="tel" type="tel" autocomplete="tel" /></div>
        <div class="campo">
          <label for="categoria">Categoría del taller</label>
          <select id="categoria" name="categoria" required>
            <option value="">Elige una</option>
            {categorias.map((c) => <option>{c}</option>)}
          </select>
        </div>
        <div class="campo">
          <label for="propuesta">Tu propuesta</label>
          <small>Idea de taller o talleres, duración y precio aproximado.</small>
          <textarea id="propuesta" name="propuesta" rows="5" required></textarea>
        </div>
        <div class="campo">
          <label for="fotos">Alguna foto de tus talleres o trabajos</label>
          <input id="fotos" name="fotos" type="file" accept="image/*" multiple />
        </div>
        <div class="dos-col">
          <fieldset class="campo">
            <legend>¿Has impartido talleres antes?</legend>
            <label class="casilla"><input type="radio" name="experiencia" value="si" required /> Sí</label>
            <label class="casilla"><input type="radio" name="experiencia" value="no" /> No</label>
          </fieldset>
          <fieldset class="campo">
            <legend>¿Eres autónoma?</legend>
            <label class="casilla"><input type="radio" name="autonoma" value="si" required /> Sí</label>
            <label class="casilla"><input type="radio" name="autonoma" value="no" /> No</label>
          </fieldset>
        </div>
        <label class="casilla"><input type="checkbox" required /> Acepto la <a href="/privacidad">política de privacidad</a> y que Yutori guarde mi propuesta para futuras colaboraciones.</label>
        <button class="boton" type="submit">Enviar propuesta</button>
        <p class="aviso-prototipo" data-resultado hidden>Prototipo: todavía no se envía nada. En el bloque 3 la propuesta llegará al panel de Iris, clasificada por categoría.</p>
      </form>
    </div>
  </section>
</Base>
