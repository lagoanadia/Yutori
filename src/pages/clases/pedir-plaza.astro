---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import { DIAS } from '../../lib/db';
import { disponibilidadSueltas, gruposActivos, mesInscripcion, nombreMes, ocupacionMes, reservarMensual, reservarSuelta } from '../../lib/clases';
import { turnstileActivo, verificarTurnstile } from '../../lib/turnstile';
import { esEmail } from '../../lib/util';
import { fechaLarga } from '../../data/yutori';

// Desde /clases se llega con ?clase=slug: solo se ven los horarios de esa clase.
const todosGrupos = await gruposActivos();
const slug = Astro.url.searchParams.get('clase');
const grupos = todosGrupos.some((g) => g.slug === slug) ? todosGrupos.filter((g) => g.slug === slug) : todosGrupos;
const clase = grupos.length && grupos.every((g) => g.slug === grupos[0].slug) ? grupos[0] : null;

// Plaza mensual: solo el mes en el que están abiertas las inscripciones.
const mes = mesInscripcion();
const [ocupacion, sueltas] = await Promise.all([ocupacionMes(mes), disponibilidadSueltas(grupos)]);
const libresMes = (id: number) => Math.max(0, grupos.find((g) => g.id === id)!.plazas - (ocupacion.get(id) ?? 0));
const hayAdultos = grupos.some((g) => g.publico === 'adultos');

const errores: string[] = [];
let v = { tipo: 'mensual', grupo: '', sesion: '', modalidad: '', nombre: '', telefono: '', email: '', menor: '' };

if (Astro.request.method === 'POST') {
  const datos = await Astro.request.formData();
  const campo = (k: string, max = 160) => String(datos.get(k) ?? '').trim().slice(0, max);
  v = {
    tipo: campo('tipo', 10), grupo: campo('grupo', 6), sesion: campo('sesion', 20), modalidad: campo('modalidad', 40),
    nombre: campo('nombre', 120), telefono: campo('telefono', 30), email: campo('email'), menor: campo('menor', 120),
  };
  if (campo('web')) return Astro.redirect('/clases', 303);

  // Semanal: el horario llega en «grupo». Clase suelta: «sesion» = "grupo|fecha".
  const [idSesion, fecha] = v.sesion.split('|');
  const g = grupos.find((x) => String(x.id) === (v.tipo === 'suelta' ? idSesion : v.grupo));
  const modalidades: string[] = g ? JSON.parse(g.modalidades) : [];
  if (!['mensual', 'suelta'].includes(v.tipo)) errores.push('Elige la frecuencia: semanal o clase suelta.');
  else if (!g) errores.push(v.tipo === 'suelta' ? 'Elige el día de tu clase suelta.' : 'Elige el horario.');
  if (g && v.tipo === 'suelta' && (g.publico !== 'adultos' || !(sueltas.get(g.id) ?? []).some((s) => s.fecha === fecha && s.libres > 0))) {
    errores.push('Ese día ya no tiene plazas. Elige otro.');
  }
  if (modalidades.length > 0 && !modalidades.includes(v.modalidad)) errores.push('Elige la modalidad (con o sin máquina).');
  if (g?.publico === 'ninos' && !v.menor) errores.push('Escribe el nombre del niño o niña.');
  if (!v.nombre) errores.push('Escribe tu nombre y apellidos.');
  if (v.telefono.replace(/\D/g, '').length < 9) errores.push('Escribe un teléfono de contacto.');
  if (!esEmail(v.email)) errores.push('Escribe un email válido.');
  if (datos.get('condiciones') !== 'on' || datos.get('privacidad') !== 'on') errores.push('Tienes que aceptar las condiciones y la política de privacidad.');

  if (errores.length === 0 && !(await verificarTurnstile(datos.get('cf-turnstile-response'), Astro.request.headers.get('CF-Connecting-IP')))) {
    errores.push('No hemos podido comprobar que no eres un robot. Vuelve a intentarlo.');
  }

  if (errores.length === 0 && g) {
    const alumna = { nombre: v.nombre, telefono: v.telefono, email: v.email, modalidad: v.modalidad || null, menor: g.publico === 'ninos' ? v.menor : null };
    const codigo = v.tipo === 'mensual' ? await reservarMensual(g.id, mes, alumna) : await reservarSuelta(g.id, fecha, alumna);
    if (codigo) return Astro.redirect(`/reserva/${codigo}`, 303);
    errores.push(v.tipo === 'mensual'
      ? `No quedan plazas en ese horario para ${nombreMes(mes)}. Prueba otro horario o escríbenos para la lista de espera.`
      : 'Ese día ya no quedan plazas. Prueba otro día.');
  }
}

const mesCorto = nombreMes(mes).split(' ')[0];
const Mes = mesCorto[0].toUpperCase() + mesCorto.slice(1);
const horas = (g: (typeof grupos)[number]) => `${g.hora_inicio}-${g.hora_fin}h`;

const etiquetaClase = (g: (typeof grupos)[number]) => (clase ? '' : `${g.nombre} · `) + (g.publico === 'ninos' ? 'Niños · ' : '');
const plazasTexto = (n: number) => (n === 0 ? 'completo' : `${n} ${n === 1 ? 'plaza libre' : 'plazas libres'}`);
const sesiones = [...sueltas].flatMap(([gid, lista]) => lista.map((s) => ({ g: grupos.find((x) => x.id === gid)!, ...s })))
  .sort((a, b) => (a.fecha + a.g.hora_inicio).localeCompare(b.fecha + b.g.hora_inicio));
---
<Base titulo="Reservar plaza">
  <Fragment slot="head">
    {turnstileActivo() && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  </Fragment>
  <section class="seccion">
    <div class="contenedor pagina-formulario">
      <div class="pagina-formulario__lado">
        <div class="cabecera-pagina cabecera-pagina--columna">
          <p class="script">Curso 26/27</p>
          <h1>Reservar plaza</h1>
          <p class="intro">Elige tu clase y si vienes cada semana o a una clase suelta. Te confirmamos la plaza cuando recibamos el pago.</p>
        </div>
        <div class="lamina" aria-hidden="true"><span class="mariposa-marca"></span></div>
      </div>

      <div class="hoja">
      {errores.length > 0 && <div class="errores" role="alert"><p><strong>Revisa estos datos:</strong></p><ul>{errores.map((e) => <li>{e}</li>)}</ul></div>}

      <form class="formulario" method="post" id="form-clase">
        <fieldset class="campo">
          <legend>Frecuencia</legend>
          <label class="casilla"><input type="radio" name="tipo" value="mensual" checked={v.tipo !== 'suelta'} /> Semanal</label>
          {hayAdultos && <label class="casilla"><input type="radio" name="tipo" value="suelta" checked={v.tipo === 'suelta'} /> Clase suelta</label>}
        </fieldset>

        <div class="campo" data-tipo="mensual">
          <label for="grupo">Horario</label>
          <select id="grupo" name="grupo">
            <option value="">Elige uno</option>
            {grupos.map((g) => (
              <option value={g.id} selected={String(g.id) === v.grupo} disabled={libresMes(g.id) === 0}
                data-publico={g.publico} data-modalidades={g.modalidades}>
                {Mes}, {etiquetaClase(g)}{DIAS[g.dia_semana]} {horas(g)} · {plazasTexto(libresMes(g.id))}
              </option>
            ))}
          </select>
        </div>

        {hayAdultos && (
          <div class="campo" data-tipo="suelta">
            <label for="sesion">Día y horario</label>
            <select id="sesion" name="sesion">
              <option value="">Elige un día</option>
              {sesiones.map((s) => (
                <option value={`${s.g.id}|${s.fecha}`} disabled={s.libres === 0} selected={`${s.g.id}|${s.fecha}` === v.sesion}
                  data-publico="adultos" data-modalidades={s.g.modalidades}>
                  {fechaLarga(s.fecha)}, {etiquetaClase(s.g)}{horas(s.g)} · {plazasTexto(s.libres)}
                </option>
              ))}
            </select>
          </div>
        )}

        <div class="campo" data-modalidad>
          <label for="modalidad">Modalidad</label>
          <select id="modalidad" name="modalidad">
            <option value="">Elige una</option>
            <option selected={v.modalidad === 'Con máquina'}>Con máquina</option>
            <option selected={v.modalidad === 'Sin máquina'}>Sin máquina</option>
          </select>
        </div>

        <div class="campo" data-solo-ninos>
          <label for="menor">Nombre del niño o niña</label>
          <small>Rellena el resto del formulario con tus datos como madre, padre o tutor.</small>
          <input id="menor" name="menor" maxlength="120" value={v.menor} />
        </div>

        <div class="dos-col">
          <div class="campo"><label for="nombre">Nombre y apellidos</label><input id="nombre" name="nombre" autocomplete="name" maxlength="120" value={v.nombre} required /></div>
          <div class="campo"><label for="telefono">Teléfono</label><input id="telefono" name="telefono" type="tel" autocomplete="tel" maxlength="30" value={v.telefono} required /></div>
        </div>
        <div class="campo"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" maxlength="160" value={v.email} required /></div>
        <div class="trampa" aria-hidden="true"><label for="web">No rellenes este campo</label><input id="web" name="web" tabindex="-1" autocomplete="off" /></div>
        <label class="casilla"><input type="checkbox" name="condiciones" required /> He leído y acepto las <a href="/condiciones">condiciones de reserva y cancelación</a>.</label>
        <label class="casilla"><input type="checkbox" name="privacidad" required /> Acepto la <a href="/privacidad">política de privacidad</a>.</label>
        {turnstileActivo() && <div class="cf-turnstile" data-sitekey={env.TURNSTILE_SITE_KEY} data-language="es" data-theme="light"></div>}
        <button class="boton" type="submit">Reservar plaza</button>
      </form>
      </div>
    </div>
  </section>
</Base>

<script is:inline>
  // Primero la frecuencia; después solo se ven los horarios (semanal) o los días (clase suelta) que tocan.
  // Sin JavaScript se ve todo y el servidor valida.
  const form = document.getElementById('form-clase');
  const actualizar = () => {
    const tipo = form.querySelector('input[name=tipo]:checked')?.value ?? 'mensual';
    for (const c of form.querySelectorAll('[data-tipo]')) c.hidden = c.dataset.tipo !== tipo;
    const op = form.querySelector(tipo === 'suelta' ? '#sesion' : '#grupo')?.selectedOptions[0];
    const ninos = op?.dataset.publico === 'ninos';
    form.querySelector('[data-solo-ninos]').hidden = !ninos;
    form.querySelector('[data-modalidad]').hidden = (op?.dataset.modalidades ?? '[]') === '[]';
  };
  form.addEventListener('change', actualizar);
  actualizar();
</script>
