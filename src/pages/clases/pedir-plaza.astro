---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import { DIAS } from '../../lib/db';
import { disponibilidadSueltas, gruposActivos, meses, mesInscripcion, nombreMes, ocupacionMes, reservarMensual, reservarSuelta } from '../../lib/clases';
import { turnstileActivo, verificarTurnstile } from '../../lib/turnstile';
import { esEmail } from '../../lib/util';
import { fechaLarga, textosPago } from '../../data/yutori';
import { iniciarPago } from '../../lib/pagos';

// Desde /clases se llega con ?clase=slug: solo se ven los horarios de esa clase.
const todosGrupos = await gruposActivos();
const slug = Astro.url.searchParams.get('clase');
const grupos = todosGrupos.some((g) => g.slug === slug) ? todosGrupos.filter((g) => g.slug === slug) : todosGrupos;
const clase = grupos.length && grupos.every((g) => g.slug === grupos[0].slug) ? grupos[0] : null;

// Plaza mensual: solo el mes en el que están abiertas las inscripciones (desde el día 26, el siguiente). Del 1 al 25
// no se entra a mitad de mes: solo clases sueltas.
const mes = mesInscripcion();
const mesAbierto = mes !== null;
const [ocupacion, sueltas] = await Promise.all([mes ? ocupacionMes(mes) : new Map<number, number>(), disponibilidadSueltas(grupos)]);
const libresMes = (id: number) => Math.max(0, grupos.find((g) => g.id === id)!.plazas - (ocupacion.get(id) ?? 0));
const hayAdultos = grupos.some((g) => g.publico === 'adultos');

const errores: string[] = [];
let v = { tipo: mesAbierto || !hayAdultos ? 'mensual' : 'suelta', grupo: '', sesion: '', modalidad: '', nombre: '', telefono: '', email: '', menor: '' };

if (Astro.request.method === 'POST') {
  const datos = await Astro.request.formData();
  const campo = (k: string, max = 160) => String(datos.get(k) ?? '').trim().slice(0, max);
  v = {
    tipo: campo('tipo', 10), grupo: campo('grupo', 6), sesion: campo('sesion', 20), modalidad: campo('modalidad', 40),
    nombre: campo('nombre', 120), telefono: campo('telefono', 30), email: campo('email'), menor: campo('menor', 120),
  };
  if (campo('web')) return Astro.redirect('/clases', 303);

  // Semanal: el horario llega en «grupo». Clase suelta: «sesion» = "grupo|fecha".
  const [idSesion, fecha] = v.sesion.split('|');
  const g = grupos.find((x) => String(x.id) === (v.tipo === 'suelta' ? idSesion : v.grupo));
  const modalidades: string[] = g ? JSON.parse(g.modalidades) : [];
  if (!['mensual', 'suelta'].includes(v.tipo) || (v.tipo === 'mensual' && !mesAbierto)) errores.push('Elige la frecuencia: semanal o clase suelta.');
  else if (!g) errores.push(v.tipo === 'suelta' ? 'Elige el día de tu clase suelta.' : 'Elige el horario.');
  if (g && v.tipo === 'suelta' && (g.publico !== 'adultos' || !(sueltas.get(g.id) ?? []).some((s) => s.fecha === fecha && s.libres > 0))) {
    errores.push('Ese día ya no tiene plazas. Elige otro.');
  }
  if (modalidades.length > 0 && !modalidades.includes(v.modalidad)) errores.push('Elige la modalidad (con o sin máquina).');
  if (g?.publico === 'ninos' && !v.menor) errores.push('Escribe el nombre del niño o niña.');
  if (!v.nombre) errores.push('Escribe tu nombre y apellidos.');
  if (v.telefono.replace(/\D/g, '').length < 9) errores.push('Escribe un teléfono de contacto.');
  if (!esEmail(v.email)) errores.push('Escribe un email válido.');
  if (datos.get('condiciones') !== 'on' || datos.get('privacidad') !== 'on') errores.push('Tienes que aceptar las condiciones y la política de privacidad.');

  if (errores.length === 0 && !(await verificarTurnstile(datos.get('cf-turnstile-response'), Astro.request.headers.get('CF-Connecting-IP')))) {
    errores.push('No hemos podido comprobar que no eres un robot. Vuelve a intentarlo.');
  }

  if (errores.length === 0 && g) {
    const alumna = { nombre: v.nombre, telefono: v.telefono, email: v.email, modalidad: v.modalidad || null, menor: g.publico === 'ninos' ? v.menor : null };
    const codigo = v.tipo === 'mensual' && mes ? await reservarMensual(g.id, mes, alumna) : await reservarSuelta(g.id, fecha, alumna);
    // Con tarjeta se va directa a pagar; si Stripe falla, su página de reserva tiene el botón para reintentarlo.
    if (codigo) return Astro.redirect((await iniciarPago(codigo, Astro.url.origin).catch(() => null)) ?? `/reserva/${codigo}`, 303);
    errores.push(v.tipo === 'mensual'
      ? `No quedan plazas en ese horario para ${nombreMes(mes!)}. Prueba otro horario o escríbenos para la lista de espera.`
      : 'Ese día ya no quedan plazas. Prueba otro día.');
  }
}

const mesCorto = nombreMes(mes ?? meses().siguiente).split(' ')[0];
const Mes = mesCorto[0].toUpperCase() + mesCorto.slice(1);
const horas = (g: (typeof grupos)[number]) => `${g.hora_inicio}-${g.hora_fin}h`;

const etiquetaClase = (g: (typeof grupos)[number]) => (clase ? '' : `${g.nombre} · `) + (g.publico === 'ninos' ? 'Niños · ' : '');
const plazasTexto = (n: number) => (n === 0 ? 'completo' : `${n} ${n === 1 ? 'plaza libre' : 'plazas libres'}`);
const sesiones = [...sueltas].flatMap(([gid, lista]) => lista.map((s) => ({ g: grupos.find((x) => x.id === gid)!, ...s })))
  .sort((a, b) => (a.fecha + a.g.hora_inicio).localeCompare(b.fecha + b.g.hora_inicio));
---
<Base titulo="Reservar plaza">
  <Fragment slot="head">
    {turnstileActivo() && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  </Fragment>
  <section class="seccion">
    <div class="contenedor pagina-formulario">
      <div class="pagina-formulario__lado">
        <div class="cabecera-pagina cabecera-pagina--columna">
          <p class="script">Curso 26/27</p>
          <h1>Reservar plaza</h1>
          <p class="intro">Elige tu clase y si vienes cada semana o a una clase suelta. Te confirmamos la plaza cuando recibamos el pago.</p>
        </div>
        <div class="lamina" aria-hidden="true"><span class="mariposa-marca"></span></div>
      </div>

      <div class="hoja">
      {errores.length > 0 && <div class="errores" role="alert"><p><strong>Revisa estos datos:</strong></p><ul>{errores.map((e) => <li>{e}</li>)}</ul></div>}

      <form class="formulario formulario-grande" method="post" id="form-clase">
        {/* Por pasos con JavaScript (pasos.ts); sin él se ve el formulario entero y el servidor valida igual. */}
        <div class="pasos-progreso" role="progressbar" aria-label="Progreso de la reserva" aria-valuemin="1" aria-valuemax="4" aria-valuenow="1" hidden>
          <span></span><span></span><span></span><span></span>
        </div>
        <div class="pasos-ventana">
          <div class="pasos-pista">
            <div data-paso>
              <fieldset class="campo">
                <legend>Frecuencia</legend>
                <div class="opciones">
                  <label class="opcion" data-desactivada={!mesAbierto ? '' : undefined}>
                    <input type="radio" name="tipo" value="mensual" checked={v.tipo !== 'suelta'} disabled={!mesAbierto} />
                    <span class="opcion__marca" aria-hidden="true"></span><span>Semanal</span>
                  </label>
                  {hayAdultos && (
                    <label class="opcion">
                      <input type="radio" name="tipo" value="suelta" checked={v.tipo === 'suelta'} />
                      <span class="opcion__marca" aria-hidden="true"></span><span>Clase suelta</span>
                    </label>
                  )}
                </div>
              </fieldset>
              {!mesAbierto && <p class="aviso-mes">{textosPago.inscripcionCerrada(nombreMes(meses().siguiente).split(' ')[0])}</p>}
            </div>

            <div data-paso>
              <fieldset class="campo" data-tipo="mensual" hidden={!mesAbierto}>
                <legend>Horario</legend>
                <div class="opciones">
                  {grupos.map((g) => (
                    <label class="opcion opcion--doble">
                      <input type="radio" name="grupo" value={g.id} checked={String(g.id) === v.grupo} disabled={libresMes(g.id) === 0}
                        data-publico={g.publico} data-modalidades={g.modalidades} />
                      <span class="opcion__marca" aria-hidden="true"></span>
                      <span>{Mes}, {etiquetaClase(g)}{DIAS[g.dia_semana]} {horas(g)}<small>{plazasTexto(libresMes(g.id))}</small></span>
                    </label>
                  ))}
                </div>
              </fieldset>
              {hayAdultos && (
                <fieldset class="campo" data-tipo="suelta">
                  <legend>Día y horario</legend>
                  <div class="opciones">
                    {sesiones.map((s) => (
                      <label class="opcion opcion--doble">
                        <input type="radio" name="sesion" value={`${s.g.id}|${s.fecha}`} disabled={s.libres === 0} checked={`${s.g.id}|${s.fecha}` === v.sesion}
                          data-publico="adultos" data-modalidades={s.g.modalidades} />
                        <span class="opcion__marca" aria-hidden="true"></span>
                        <span>{fechaLarga(s.fecha)}, {etiquetaClase(s.g)}{horas(s.g)}<small>{plazasTexto(s.libres)}</small></span>
                      </label>
                    ))}
                  </div>
                </fieldset>
              )}
              <fieldset class="campo" data-modalidad>
                <legend>Modalidad</legend>
                <div class="opciones opciones--dos">
                  {['Con máquina', 'Sin máquina'].map((m) => (
                    <label class="opcion"><input type="radio" name="modalidad" value={m} checked={v.modalidad === m} /><span class="opcion__marca" aria-hidden="true"></span><span>{m}</span></label>
                  ))}
                </div>
              </fieldset>
              <div class="campo" data-solo-ninos>
                <label for="menor">Nombre del niño o niña</label>
                <small>Rellena el resto del formulario con tus datos como madre, padre o tutor.</small>
                <input id="menor" name="menor" maxlength="120" value={v.menor} />
              </div>
            </div>

            <div data-paso>
              <div class="campo"><label for="nombre">Nombre y apellidos</label><input id="nombre" name="nombre" autocomplete="name" maxlength="120" value={v.nombre} required /></div>
              <div class="campo"><label for="telefono">Teléfono</label><input id="telefono" name="telefono" type="tel" autocomplete="tel" maxlength="30" value={v.telefono} required pattern="\s*\+?[\d\s().\-]{9,}" title="Escribe un teléfono de contacto." /></div>
              <div class="campo"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" maxlength="160" value={v.email} required /></div>
            </div>

            <div data-paso>
              <div class="trampa" aria-hidden="true"><label for="web">No rellenes este campo</label><input id="web" name="web" tabindex="-1" autocomplete="off" /></div>
              <label class="casilla"><input type="checkbox" name="condiciones" required /> He leído y acepto las <a href="/condiciones">condiciones de reserva y cancelación</a>.</label>
              <label class="casilla"><input type="checkbox" name="privacidad" required /> Acepto la <a href="/privacidad">política de privacidad</a>.</label>
              {turnstileActivo() && <div class="cf-turnstile" data-sitekey={env.TURNSTILE_SITE_KEY} data-language="es" data-theme="light"></div>}
              <button class="boton" type="submit">Reservar plaza</button>
            </div>
          </div>
        </div>
        <div class="pasos-nav" hidden>
          <button type="button" class="pasos-flecha pasos-flecha--atras" aria-label="Paso anterior">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
          </button>
          <button type="button" class="pasos-flecha pasos-flecha--siguiente" aria-label="Paso siguiente">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </button>
        </div>
      </form>
      </div>
    </div>
  </section>
</Base>

<script>
  import { formularioPorPasos } from '../../scripts/pasos';

  // Primero la frecuencia; después solo se ven los horarios (semanal) o los días (clase suelta) que tocan.
  // Sin JavaScript se ve todo y el servidor valida.
  const form = document.getElementById('form-clase') as HTMLFormElement;
  const actualizar = () => {
    const tipo = form.querySelector<HTMLInputElement>('input[name=tipo]:checked')?.value ?? 'mensual';
    for (const c of form.querySelectorAll<HTMLElement>('[data-tipo]')) c.hidden = c.dataset.tipo !== tipo;
    const elegido = form.querySelector<HTMLInputElement>(`input[name=${tipo === 'suelta' ? 'sesion' : 'grupo'}]:checked`);
    const modalidad = form.querySelector<HTMLElement>('[data-modalidad]')!;
    form.querySelector<HTMLElement>('[data-solo-ninos]')!.hidden = elegido?.dataset.publico !== 'ninos';
    modalidad.hidden = (elegido?.dataset.modalidades ?? '[]') === '[]';
    // Obligatorio solo lo que se ve: así cada paso avisa de lo suyo y lo oculto no bloquea el envío.
    form.querySelectorAll<HTMLInputElement>('input[name=grupo]').forEach((i) => { i.required = tipo === 'mensual'; });
    form.querySelectorAll<HTMLInputElement>('input[name=sesion]').forEach((i) => { i.required = tipo === 'suelta'; });
    form.querySelectorAll<HTMLInputElement>('input[name=modalidad]').forEach((i) => { i.required = !modalidad.hidden; });
    (form.querySelector('#menor') as HTMLInputElement).required = elegido?.dataset.publico === 'ninos';
  };
  form.addEventListener('change', actualizar);
  actualizar();
  formularioPorPasos(form, { antesDeMostrar: actualizar });
</script>

<style>
  .aviso-mes { background: var(--salvia-suave); color: var(--verde-profundo); border-radius: 14px; padding: 12px 16px; margin: 12px 0 0; }
  .opcion--doble span small { display: block; font-size: 0.82rem; font-weight: 500; color: var(--tinta-suave); margin-top: 2px; }
  .opciones--dos { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .opcion[data-desactivada] { opacity: 0.5; }
  @media (max-width: 759px) {
    /* En el móvil el formulario ya es una tarjeta: sin la hoja de alrededor. */
    .hoja { background: none; box-shadow: none; padding: 0; }
    .lamina { display: none; }
  }
</style>
