---
export const prerender = false;
import Base from '../layouts/Base.astro';
import { PLAZAS_CLASE, politicaClases } from '../data/yutori';
import { DIAS, eurosCorto } from '../lib/db';
import { gruposActivos, meses, mesInscripcion, nombreMes, ocupacionMes, type Grupo } from '../lib/clases';
import { urlFoto } from '../lib/fotos';

// Desde el día 26 se muestran ya las plazas del mes siguiente (es cuando se abren las inscripciones); antes, las de este mes.
const mesMostrado = mesInscripcion() ?? meses().actual;
const [grupos, ocupacion] = await Promise.all([gruposActivos(), ocupacionMes(mesMostrado)]);

type Clase = { slug: string; nombre: string; tipo: string; colabora: string | null; texto: string | null; temas: string[];
  kit: boolean; modalidades: string[]; precioSuelta: number | null; publicos: Map<string, Grupo[]>;
  profe: { nombre: string; texto: string | null; foto: string | null } | null };
const clases = new Map<string, Clase>();
for (const g of grupos) {
  const c = clases.get(g.slug) ?? {
    slug: g.slug, nombre: g.nombre, tipo: g.tipo, colabora: g.colabora, texto: g.texto, temas: JSON.parse(g.temas),
    kit: !!g.kit_incluido, modalidades: JSON.parse(g.modalidades), precioSuelta: g.precio_suelta_cent, publicos: new Map(),
    profe: g.profe_nombre ? { nombre: g.profe_nombre, texto: g.profe_texto, foto: g.profe_foto } : null,
  };
  c.publicos.set(g.publico, [...(c.publicos.get(g.publico) ?? []), g]);
  clases.set(g.slug, c);
}
const precioMes = (g: Grupo) => g.precio_mes_max_cent
  ? `${(g.precio_mes_cent ?? 0) / 100}-${eurosCorto(g.precio_mes_max_cent)}/mes`
  : `${eurosCorto(g.precio_mes_cent)}/mes`;
const libres = (g: Grupo) => Math.max(0, g.plazas - (ocupacion.get(g.id) ?? 0));
---
<Base titulo="Clases semanales" descripcion="Clases semanales de ganchillo, acuarela y atelier textil en A Coruña, para adultos y niños. Grupos de 8 personas como máximo.">
  <section class="seccion">
    <div class="contenedor">
      <div class="cabecera-pagina">
        <p class="script">Curso 26/27</p>
        <h1>Clases semanales</h1>
      </div>

      {/* Móvil: una clase cada vez, con pestañas arriba y el botón de reservar fijo abajo. */}
      <nav class="pestanas-clases" aria-label="Clases">
        {[...clases.values()].map((c, i) => <a href={`#${c.slug}`} aria-current={i === 0 ? 'true' : undefined} data-pestana={c.slug}>{c.nombre}</a>)}
      </nav>
      <div class="rejilla clases">
        {[...clases.values()].map((c) => (
          <article class="tarjeta clase" id={c.slug}>
            <div class="foto-hueco">Foto de la clase</div>
            <span class="etiqueta">{c.tipo}</span>
            <h2>{c.nombre}</h2>
            {c.colabora && <p class="clase__colabora">{c.colabora}</p>}
            <p>{c.texto}</p>
            <ul class="temas" aria-label="Qué se trabaja">{c.temas.map((t) => <li>{t}</li>)}</ul>
            {c.profe && (
              <div class="profe">
                {c.profe.foto && <img class="profe__foto" src={urlFoto(c.profe.foto)} alt={c.profe.nombre} width="64" height="64" loading="lazy" />}
                <p><strong class="profe__nombre">{c.profe.nombre}</strong>{c.profe.texto && <span>{c.profe.texto}</span>}</p>
              </div>
            )}

            {[...c.publicos].map(([publico, lista]) => (
              <div class="publico">
                <h3>
                  {publico === 'ninos' ? 'Niños' : 'Adultos'}
                  <span class="publico__precio">{precioMes(lista[0])}{publico === 'adultos' && c.precioSuelta && ` · ${eurosCorto(c.precioSuelta)} clase suelta`}</span>
                </h3>
                <ul class="horarios">
                  {lista.map((g) => (
                    <li>
                      <span><strong>{DIAS[g.dia_semana]}</strong> {g.hora_inicio}-{g.hora_fin}</span>
                      <span class:list={['libres', { 'libres--no': libres(g) === 0 }]}>{libres(g) === 0 ? 'Completo' : `${libres(g)} libres`}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
            <p class="mes-plazas">Plazas de {nombreMes(mesMostrado)}</p>

            <ul class="incluye">
              <li>Grupo máximo de {PLAZAS_CLASE} personas</li>
              {c.kit && <li>Kit de iniciación incluido</li>}
              {c.modalidades.length > 0 && <li>Modalidades: {c.modalidades.join(' / ')}</li>}
            </ul>

            <div class="botones">
              <a class="boton" href={`/clases/pedir-plaza?clase=${c.slug}`}>Reservar plaza</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div class="dock-clases"><a class="boton" href={`/clases/pedir-plaza?clase=${[...clases.values()][0]?.slug ?? ''}`} data-reservar>Reservar plaza</a></div>

  <section class="seccion seccion--salvia">
    <div class="contenedor">
      <h2>Cómo funcionan</h2>
      <div class="como">
        {[
          { titulo: 'Plazas', lineas: [
            'Las alumnas mensuales tienen prioridad para seguir el mes siguiente.',
            'Si quedan plazas libres, se ofrecen como clases sueltas.',
            'Las clases se mantienen aunque haya una sola persona apuntada.',
          ] },
          { titulo: 'Pago', lineas: politicaClases.filter((p) => !p.startsWith('Si cancelas')) },
          { titulo: 'Cancelaciones', lineas: politicaClases.filter((p) => p.startsWith('Si cancelas')) },
        ].map((b) => (
          <div class="como__bloque">
            <h3>{b.titulo}</h3>
            <ul class="lista-politica">{b.lineas.map((l) => <li>{l}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  // Móvil: las clases se deslizan de lado; la pestaña y el botón de reservar siguen a la clase que se ve.
  const lista = document.querySelector<HTMLElement>('.clases');
  const pestanas = [...document.querySelectorAll<HTMLAnchorElement>('[data-pestana]')];
  const reservar = document.querySelector<HTMLAnchorElement>('[data-reservar]');
  if (lista && reservar) {
    const marcar = (slug: string) => {
      pestanas.forEach((p) => p.toggleAttribute('aria-current', p.dataset.pestana === slug));
      const pestana = pestanas.find((p) => p.dataset.pestana === slug);
      if (pestana) pestana.parentElement!.scrollTo({ left: pestana.offsetLeft - 16 });
      reservar.href = `/clases/pedir-plaza?clase=${slug}`;
    };
    const observador = new IntersectionObserver((entradas) => {
      for (const e of entradas) if (e.isIntersecting) marcar(e.target.id);
    }, { root: lista, threshold: 0.6 });
    lista.querySelectorAll('.clase').forEach((c) => observador.observe(c));
    pestanas.forEach((p) => p.addEventListener('click', (e) => {
      e.preventDefault();
      // Solo de lado: la página no se mueve hacia abajo.
      const clase = document.getElementById(p.dataset.pestana!);
      if (!clase) return;
      const margen = parseFloat(getComputedStyle(lista).paddingLeft) || 0;
      const izquierda = lista.scrollLeft + clase.getBoundingClientRect().left - lista.getBoundingClientRect().left - margen;
      lista.scrollTo({ left: izquierda, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    }));
  }
</script>

<style>
  .clases { grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 28px; }
  .clase { display: flex; flex-direction: column; padding: 10px 10px 26px; }
  .clase > :not(.foto-hueco) { margin-inline: 16px; }
  .clase .foto-hueco { aspect-ratio: 16 / 10; border-radius: var(--arco-foto); margin-bottom: 20px; }
  .clase .etiqueta { align-self: flex-start; }
  .clase h2 { font-size: 1.8rem; margin-bottom: 0.15em; }
  .clase__colabora { font-family: var(--serif); font-style: italic; color: var(--verde); font-size: 1.3rem; margin-bottom: 8px; }
  .temas { list-style: none; padding: 0; margin: 0 0 18px; display: flex; flex-wrap: wrap; gap: 6px; }
  .temas li { font-size: 0.84rem; background: var(--salvia-suave); color: var(--verde-profundo); border-radius: 999px; padding: 3px 11px; }
  .profe { display: flex; gap: 14px; align-items: flex-start; margin-bottom: 16px; padding: 14px; border-radius: 16px; background: var(--crema-claro); }
  .profe__foto { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; flex: none; }
  .profe p { margin: 0; font-size: 0.95rem; color: var(--tinta-suave); }
  .profe__nombre { display: block; font-family: var(--serif); font-size: 1.15rem; color: var(--verde-profundo); font-weight: 600; }
  .publico { margin-top: 6px; }
  .publico h3 { font-size: 1.15rem; margin: 8px 0 4px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 4px; }
  .publico__precio { font-family: var(--sans); font-size: 0.92rem; font-weight: 600; color: var(--tinta); letter-spacing: 0; }
  .horarios { list-style: none; padding: 0; margin: 0 0 12px; }
  .horarios li { padding: 8px 0; border-bottom: 1px solid color-mix(in srgb, var(--borde) 70%, transparent); display: flex; justify-content: space-between; gap: 8px; }
  .libres { font-size: 0.88rem; font-weight: 600; color: var(--verde); white-space: nowrap; }
  .libres--no { color: var(--aviso); }
  .mes-plazas { font-size: 0.85rem; color: var(--tinta-suave); margin-top: -4px; }
  .incluye { padding-left: 1.2em; color: var(--tinta-suave); margin: 4px 0 18px; }
  .incluye li::marker { color: var(--salvia); }
  .clase .botones { margin-top: auto; }
  .como { display: grid; gap: 28px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); align-items: start; }
  .como__bloque { padding-top: 20px; border-top: 1px solid color-mix(in srgb, var(--verde) 25%, transparent); }
  .como__bloque h3 { margin-bottom: 8px; }
  .como__bloque .lista-politica { margin: 0; }

  /* ——— Móvil: pestañas, una clase por pantalla (se desliza) y el botón de reservar fijo. ——— */
  .pestanas-clases, .dock-clases { display: none; }
  @media (max-width: 759px) {
    .cabecera-pagina h1 { font-size: 2rem; }
    .pestanas-clases { display: flex; gap: 8px; overflow-x: auto; margin: 0 0 14px; padding-bottom: 4px; scrollbar-width: none; }
    .pestanas-clases::-webkit-scrollbar { display: none; }
    .pestanas-clases a {
      flex: none; display: inline-flex; align-items: center; min-height: 42px; padding: 0 16px; border-radius: 999px;
      background: var(--crema-claro); border: 1px solid var(--borde); color: var(--tinta); text-decoration: none; font-weight: 700; font-size: 0.92rem;
    }
    .pestanas-clases a[aria-current] { background: var(--verde-profundo); border-color: var(--verde-profundo); color: #fff; }
    .clases {
      display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; align-items: start;
      margin-inline: calc(-1 * var(--margen)); padding: 0 var(--margen) 8px; scroll-padding-inline: var(--margen); scrollbar-width: none;
    }
    .clases::-webkit-scrollbar { display: none; }
    .clase { flex: none; width: 100%; scroll-snap-align: start; padding-bottom: 18px; }
    .clase .botones { display: none; }
    .clase .foto-hueco { aspect-ratio: 16 / 9; }
    .clase h2 { font-size: 1.6rem; }
    .dock-clases { display: block; position: fixed; z-index: 35; left: 0; right: 0; bottom: calc(76px + env(safe-area-inset-bottom)); padding: 12px 16px; background: linear-gradient(to top, var(--crema) 70%, transparent); }
    .dock-clases .boton { width: 100%; justify-content: center; }
    .seccion--salvia { padding-bottom: 96px; }
  }
</style>
