---
export const prerender = false;
import Panel from '../../layouts/Panel.astro';
import { todos, eurosCorto, fecha, DIAS, ESTADOS_RESERVA } from '../../lib/db';
import { gruposActivos, meses, nombreMes, renovarMes } from '../../lib/clases';
import { cambiarEstadoReserva, liberarCaducadas } from '../../lib/reservas';

const { actual, siguiente } = meses();
const mes = Astro.url.searchParams.get('mes') === actual ? actual : siguiente;
let renovadas: number | null = null;

if (Astro.request.method === 'POST') {
  const datos = await Astro.request.formData();
  const accion = String(datos.get('accion') ?? '');
  if (accion === 'renovar') {
    renovadas = await renovarMes(actual, siguiente);
  } else if (accion === 'pagado' || accion === 'cancelar') {
    await cambiarEstadoReserva(Number(datos.get('reserva')), accion);
    return Astro.redirect(`/panel/clases?mes=${mes}&ok=guardado#g${datos.get('grupo')}`, 303);
  }
}
await liberarCaducadas();

const grupos = await gruposActivos();
const alumnas = await todos<{ id: number; grupo_id: number; nombre: string; nombre_menor: string | null; telefono: string; email: string; modalidad: string | null; estado: string }>(
  `SELECT id, grupo_id, nombre, nombre_menor, telefono, email, modalidad, estado FROM reservas
   WHERE tipo = 'clase_mensual' AND mes = ?1 AND estado IN ('pendiente', 'confirmada') ORDER BY estado DESC, creado_en`, mes);
const sueltas = await todos<{ id: number; grupo_id: number; nombre: string; telefono: string; fecha_sesion: string; estado: string; caduca_en: string | null }>(
  `SELECT id, grupo_id, nombre, telefono, fecha_sesion, estado, caduca_en FROM reservas
   WHERE tipo = 'clase_suelta' AND substr(fecha_sesion, 1, 7) = ?1 AND estado IN ('pendiente', 'confirmada') ORDER BY fecha_sesion`, mes);
const confirmadasActual = (await todos<{ n: number }>(
  `SELECT count(*) AS n FROM reservas WHERE tipo = 'clase_mensual' AND mes = ?1 AND estado = 'confirmada'`, actual))[0]?.n ?? 0;
---
<Panel titulo="Clases semanales">
  <nav class="filtros" aria-label="Mes">
    <a href={`/panel/clases?mes=${actual}`} aria-current={mes === actual ? 'true' : undefined}>{nombreMes(actual)}</a>
    <a href={`/panel/clases?mes=${siguiente}`} aria-current={mes === siguiente ? 'true' : undefined}>{nombreMes(siguiente)}</a>
  </nav>

  {renovadas !== null && (
    <p class="aviso-ok" role="status">
      {renovadas === 0 ? 'No había alumnas nuevas que renovar: ya estaban todas apuntadas.' : `${renovadas} ${renovadas === 1 ? 'alumna renovada' : 'alumnas renovadas'} para ${nombreMes(siguiente)}, pendientes de pago.`}
    </p>
  )}

  <form method="post" class="tarjeta renovar">
    <input type="hidden" name="accion" value="renovar" />
    <div>
      <strong>Prioridad para tus alumnas</strong>
      <p>Reserva su plaza de {nombreMes(siguiente)} a las {confirmadasActual} alumnas confirmadas de {nombreMes(actual)}, antes de abrir las plazas libres. Quedan pendientes de pago hasta que te paguen.</p>
    </div>
    <button class="boton" type="submit" disabled={confirmadasActual === 0}>Renovar alumnas</button>
  </form>

  {grupos.map((g) => {
    const lista = alumnas.filter((a) => a.grupo_id === g.id);
    const sueltasGrupo = sueltas.filter((s) => s.grupo_id === g.id);
    return (
      <section class="grupo" id={`g${g.id}`}>
        <h2>
          {DIAS[g.dia_semana]} {g.hora_inicio}-{g.hora_fin} · {g.nombre}
          {g.publico === 'ninos' && <span class="estado">Niños</span>}
        </h2>
        <p class="grupo__resumen">
          <span class="ocupacion">
            <span class="ocupacion__barra"><span style={`width:${Math.min(100, (lista.length / g.plazas) * 100)}%`}></span></span>
            {lista.length} de {g.plazas} plazas mensuales
          </span>
          <small> · {eurosCorto(g.precio_mes_cent)}{g.precio_mes_max_cent && `-${eurosCorto(g.precio_mes_max_cent)}`}/mes</small>
        </p>
        {lista.length === 0 && sueltasGrupo.length === 0 ? <p class="vacio">Nadie apuntado en {nombreMes(mes)}.</p> : (
          <ul class="lista-apuntadas">
            {lista.map((a) => (
              <li class="tarjeta apuntada">
                <div>
                  <strong>{a.nombre_menor ? `${a.nombre_menor} (${a.nombre})` : a.nombre}</strong>{a.modalidad && <small> · {a.modalidad}</small>}<br />
                  <small><a href={`tel:${a.telefono}`}>{a.telefono}</a> · <a href={`mailto:${a.email}`}>{a.email}</a></small><br />
                  <span class={`estado estado--${a.estado}`}>{ESTADOS_RESERVA[a.estado]}</span>
                </div>
                <form method="post" class="apuntada__acciones">
                  <input type="hidden" name="reserva" value={a.id} />
                  <input type="hidden" name="grupo" value={g.id} />
                  {a.estado === 'pendiente' && <button class="boton" name="accion" value="pagado" type="submit">Pago recibido</button>}
                  <button class="boton-texto boton-texto--peligro" name="accion" value="cancelar" type="submit" onclick="return confirm('¿Cancelar esta plaza? Quedará libre.')">Cancelar</button>
                </form>
              </li>
            ))}
            {sueltasGrupo.map((s) => (
              <li class="tarjeta apuntada suelta">
                <div>
                  <strong>{s.nombre}</strong> <small>· clase suelta el {fecha(s.fecha_sesion)}</small><br />
                  <small><a href={`tel:${s.telefono}`}>{s.telefono}</a></small><br />
                  <span class={`estado estado--${s.estado}`}>{ESTADOS_RESERVA[s.estado]}</span>
                  {s.estado === 'pendiente' && s.caduca_en && <small> · hasta {fecha(s.caduca_en)}</small>}
                </div>
                <form method="post" class="apuntada__acciones">
                  <input type="hidden" name="reserva" value={s.id} />
                  <input type="hidden" name="grupo" value={g.id} />
                  {s.estado === 'pendiente' && <button class="boton" name="accion" value="pagado" type="submit">Pago recibido</button>}
                  <button class="boton-texto boton-texto--peligro" name="accion" value="cancelar" type="submit" onclick="return confirm('¿Cancelar esta clase suelta?')">Cancelar</button>
                </form>
              </li>
            ))}
          </ul>
        )}
      </section>
    );
  })}
</Panel>

<style>
  .renovar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 8px; }
  .renovar p { margin: 4px 0 0; color: var(--tinta-suave); max-width: 60ch; }
  .grupo h2 { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; font-size: 1.2rem; }
  .grupo__resumen { margin: 0 0 12px; }
  .suelta { border-style: dashed; }
</style>
