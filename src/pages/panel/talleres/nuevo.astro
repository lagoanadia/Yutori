---
export const prerender = false;
import Panel from '../../../layouts/Panel.astro';
import { todos } from '../../../lib/db';
import { crearHueco } from '../../../lib/talleres';

const aceptadas = await todos<{ id: number; nombre: string; marca: string | null; categoria: string | null }>(`
  SELECT ta.id, ta.nombre, ta.marca, c.nombre AS categoria
  FROM talleristas ta LEFT JOIN categorias c ON c.id = ta.categoria_id
  WHERE ta.estado = 'aceptada' ORDER BY COALESCE(ta.marca, ta.nombre)`);

const errores: string[] = [];
let v = { quien: Astro.url.searchParams.get('tallerista') ?? '', fecha: '', momento: 'tarde', plazas: '8', limite: '' };

if (Astro.request.method === 'POST') {
  const datos = await Astro.request.formData();
  const campo = (k: string) => String(datos.get(k) ?? '').trim();
  v = { quien: campo('quien'), fecha: campo('fecha'), momento: campo('momento'), plazas: campo('plazas'), limite: campo('limite') };

  const talleristaId = v.quien ? Number(v.quien) : null;
  const resultado = await crearHueco({
    talleristaId, fecha: v.fecha, momento: v.momento === 'manana' ? 'manana' : 'tarde', plazas: Number(v.plazas), limite: v.limite || null,
  });
  if (resultado.ok) return Astro.redirect(`/panel/talleres/${resultado.valor}?ok=creado`, 303);
  errores.push(...resultado.errores);
}
---
<Panel titulo="Nuevo hueco de taller">
  <p><a href="/panel/talleres">← Todos los talleres</a></p>
  <p class="intro">Reserva el día para una tallerista. Después le envías su enlace privado para que rellene el taller.</p>

  {errores.length > 0 && <div class="errores" role="alert"><ul>{errores.map((e) => <li>{e}</li>)}</ul></div>}

  <form method="post" class="formulario tarjeta">
    <div class="campo">
      <label for="quien">Quién lo imparte</label>
      <select id="quien" name="quien">
        <option value="" selected={v.quien === ''}>Tú (Yutori)</option>
        {aceptadas.map((a) => (
          <option value={a.id} selected={String(a.id) === v.quien}>{a.marca ? `${a.marca} (${a.nombre})` : a.nombre}{a.categoria && ` · ${a.categoria}`}</option>
        ))}
      </select>
      {aceptadas.length === 0 && <small>Aún no hay talleristas aceptadas: acéptalas desde su ficha.</small>}
    </div>
    <div class="dos-col">
      <div class="campo"><label for="fecha">Fecha</label><input id="fecha" name="fecha" type="date" value={v.fecha} required /></div>
      <fieldset class="campo">
        <legend>Franja</legend>
        <label class="casilla"><input type="radio" name="momento" value="manana" checked={v.momento === 'manana'} /> Mañana</label>
        <label class="casilla"><input type="radio" name="momento" value="tarde" checked={v.momento !== 'manana'} /> Tarde</label>
      </fieldset>
    </div>
    <div class="dos-col">
      <div class="campo"><label for="plazas">Plazas</label><input id="plazas" name="plazas" type="number" min="1" max="30" inputmode="numeric" value={v.plazas} required /></div>
      <div class="campo">
        <label for="limite">Fecha límite para enviar el taller</label>
        <input id="limite" name="limite" type="date" value={v.limite} />
        <small>Si la dejas vacía: el miércoles antes del día 20 del mes anterior.</small>
      </div>
    </div>
    <button class="boton" type="submit">Crear hueco</button>
  </form>
</Panel>

<style>
  .tarjeta.formulario { max-width: 640px; }
</style>
