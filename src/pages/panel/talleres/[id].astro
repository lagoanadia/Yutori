---
export const prerender = false;
import Panel from '../../../layouts/Panel.astro';
import { db, uno, todos, fecha, euros, FRANJAS, ESTADOS_TALLER, ESTADOS_RESERVA } from '../../../lib/db';
import { cambiarEstadoReserva, liberarCaducadas } from '../../../lib/reservas';
import { calendarioActivo } from '../../../lib/calendario';
import { desactivarTaller, editarTaller, publicarTaller, type CamposTaller } from '../../../lib/talleres';
import { borrarFoto, urlFoto } from '../../../lib/fotos';
import { codigoAleatorio, telefonoWhatsApp } from '../../../lib/util';
import { marcarPagoReserva } from '../../../lib/acciones';

type Taller = {
  id: number; tallerista_id: number | null; titulo: string | null; slug: string | null; fecha: string; franja: string;
  hora_inicio: string | null; hora_fin: string | null; precio_cent: number | null; plazas: number; foto: string | null;
  texto: string | null; materiales: string | null; es_evento: number; datos_pago: string | null; estado: string;
  pago_reserva_recibido: number; codigo_enlace: string | null; fecha_limite: string | null; google_evento: string | null;
  tallerista: string | null; tallerista_nombre: string | null; telefono: string | null; reservas: number;
};
const id = Number(Astro.params.id);
const cargar = () => uno<Taller>(`
  SELECT t.*, COALESCE(ta.marca, ta.nombre) AS tallerista, ta.nombre AS tallerista_nombre, ta.telefono,
         (SELECT count(*) FROM reservas r WHERE r.taller_id = t.id) AS reservas
  FROM talleres t LEFT JOIN talleristas ta ON ta.id = t.tallerista_id WHERE t.id = ?1`, id);

let t = Number.isInteger(id) ? await cargar() : null;
if (!t) return new Response('No encontrado', { status: 404 });

const completo = (x: Taller) => Boolean(x.titulo && x.hora_inicio && x.hora_fin && x.precio_cent != null && x.foto && x.texto && x.datos_pago);
const errores: string[] = [];
const aEuros = (c: number | null) => (c == null ? '' : String(c / 100).replace('.', ','));
let v: CamposTaller = {
  titulo: t.titulo ?? '', hora_inicio: t.hora_inicio ?? '', hora_fin: t.hora_fin ?? '', precio: aEuros(t.precio_cent),
  plazas: String(t.plazas), texto: t.texto ?? '', materiales: t.materiales ?? '', datos_pago: t.datos_pago ?? '',
  fecha: t.fecha, momento: t.franja.endsWith('manana') ? 'manana' : 'tarde',
};
let editando = false;

if (Astro.request.method === 'POST') {
  const datos = await Astro.request.formData();
  const accion = String(datos.get('accion') ?? '');
  const actualizar = (sql: string, ...p: unknown[]) => db().prepare(sql).bind(...p, id).run();

  if (accion === 'datos') {
    const campo = (k: keyof CamposTaller) => String(datos.get(k) ?? '').trim();
    v = Object.fromEntries((Object.keys(v) as (keyof CamposTaller)[]).map((k) => [k, campo(k)])) as CamposTaller;
    const archivo = datos.get('foto');
    const resultado = await editarTaller(id, v, archivo instanceof File && archivo.size > 0 ? archivo : null);
    if (resultado.ok) return Astro.redirect(`/panel/talleres/${id}?ok=guardado`, 303);
    errores.push(...resultado.errores);
    editando = true;
  }

  if (accion === 'pagado' || accion === 'cancelar') {
    await cambiarEstadoReserva(Number(datos.get('reserva')), accion, id);
    return Astro.redirect(`/panel/talleres/${id}?ok=guardado#apuntadas`, 303);
  }
  if (accion === 'evento') {
    await actualizar('UPDATE talleres SET es_evento = 1 - es_evento WHERE id = ?1');
    return Astro.redirect(`/panel/talleres/${id}?ok=guardado`, 303);
  }

  if (accion === 'pago') {
    // El valor que se quiere viene en el formulario (no es un interruptor): pulsar dos veces no deshace el cambio.
    await marcarPagoReserva(id, datos.get('valor') === '1');
    return Astro.redirect(`/panel/talleres/${id}?ok=guardado`, 303);
  }
  if (accion === 'publicar') {
    const resultado = await publicarTaller(id);
    if (resultado.ok) return Astro.redirect(`/panel/talleres/${id}?ok=publicado`, 303);
    errores.push(...resultado.errores);
  }
  if (accion === 'desactivar') {
    await desactivarTaller(id);
    return Astro.redirect(`/panel/talleres/${id}?ok=desactivado`, 303);
  }
  if (accion === 'reactivar') {
    await actualizar(`UPDATE talleres SET estado = ?1 WHERE id = ?2`, t.titulo ? 'enviado' : 'hueco');
    return Astro.redirect(`/panel/talleres/${id}?ok=guardado`, 303);
  }
  if (accion === 'enlace') {
    await actualizar('UPDATE talleres SET codigo_enlace = ?1 WHERE id = ?2', codigoAleatorio());
    return Astro.redirect(`/panel/talleres/${id}?ok=guardado`, 303);
  }
  if (accion === 'eliminar') {
    if (t.reservas > 0) errores.push('Este taller ya tiene reservas: desactívalo en lugar de eliminarlo.');
    else {
      await db().prepare('DELETE FROM talleres WHERE id = ?1').bind(id).run();
      await borrarFoto(t.foto);
      return Astro.redirect('/panel/talleres?ok=eliminado', 303);
    }
  }
}

await liberarCaducadas();
const apuntadas = await todos<{ id: number; nombre: string; telefono: string; email: string; plazas: number; estado: string; caduca_en: string | null }>(
  `SELECT id, nombre, telefono, email, plazas, estado, caduca_en FROM reservas
   WHERE taller_id = ?1 AND estado IN ('pendiente', 'confirmada') ORDER BY creado_en`, id);
const ocupadas = apuntadas.reduce((s, a) => s + a.plazas, 0);

const enlace = t.codigo_enlace ? new URL(`/t/${t.codigo_enlace}`, Astro.url.origin).href : null;
const [a, m, d] = t.fecha.split('-').map(Number);
const diaTexto = new Date(Date.UTC(a, m - 1, d)).toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', timeZone: 'UTC' });
const mesTexto = new Date(Date.UTC(a, m - 1, 1)).toLocaleDateString('es-ES', { month: 'long', timeZone: 'UTC' });
const limiteTexto = t.fecha_limite
  ? new Date(t.fecha_limite + 'T00:00:00Z').toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' })
  : null;
const momento = t.franja.endsWith('manana') ? 'mañana' : 'tarde';
const mensaje = `¡Buenos días! Te confirmo fecha para el taller de ${mesTexto}:\n*${diaTexto} por la ${momento}*.\n\n` +
  `${limiteTexto ? `Antes del ${limiteTexto}` : 'Cuando puedas'} necesito que rellenes los datos de tu taller aquí:\n${enlace}\n` +
  `(nombre, horario, foto del producto —no cartel—, texto informativo y cómo te pagan las alumnas)\n\n` +
  `Y el pago de la reserva (25 €/taller). ¡Gracias! ✨`;
const tel = telefonoWhatsApp(t.telefono);
const whatsapp = `https://wa.me/${tel}?text=${encodeURIComponent(mensaje)}`;
---
<Panel titulo={t.titulo ?? `Hueco · ${fecha(t.fecha)}`}>
  <p><a href="/panel/talleres">← Todos los talleres</a></p>
  {errores.length > 0 && <div class="errores" role="alert"><ul>{errores.map((e) => <li>{e}</li>)}</ul></div>}

  <p class="cabecera-taller">
    <span class={`estado estado--${t.estado}`}>{ESTADOS_TALLER[t.estado]}</span>
    <strong>{fecha(t.fecha)}</strong> · {FRANJAS[t.franja]} · {t.tallerista ?? 'Tú (Yutori)'} · {t.plazas} plazas
    {t.reservas > 0 && <> · <a href={`/panel/reservas`}>{t.reservas} reservas</a></>}
  </p>

  <div class="ficha-panel">
    <section class="tarjeta">
      <h2>Datos del taller</h2>
      {!t.titulo ? (
        <p class="vacio">La tallerista todavía no ha enviado los datos{limiteTexto && ` (fecha límite: ${limiteTexto})`}.</p>
      ) : (
        <>
          {t.foto && <img class="foto-taller" src={urlFoto(t.foto)} alt={`Foto de ${t.titulo}`} />}
          <dl class="datos">
            <dt>Horario</dt><dd>{t.hora_inicio}-{t.hora_fin}</dd>
            <dt>Precio</dt><dd>{euros(t.precio_cent)}</dd>
            <dt>Plazas</dt><dd>{t.plazas}</dd>
            <dt>Materiales</dt><dd>{t.materiales ?? '—'}</dd>
            <dt>Cómo se paga</dt><dd>{t.datos_pago ?? '—'}</dd>
            <dt>Evento especial</dt><dd>{t.es_evento ? 'Sí' : 'No'}</dd>
          </dl>
          <p class="texto">{t.texto}</p>
          {t.estado === 'publicado' && t.slug && <p><small>En la web: <a href={`/talleres/${t.slug}`} target="_blank">/talleres/{t.slug}</a></small></p>}
        </>
      )}

      <details class="editar" open={editando}>
        <summary class="boton boton--borde">{t.titulo ? 'Editar datos' : 'Rellenar los datos tú'}</summary>
        <form method="post" enctype="multipart/form-data" class="formulario">
          <input type="hidden" name="accion" value="datos" />
          <div class="campo"><label for="titulo">Nombre del taller</label><input id="titulo" name="titulo" value={v.titulo} maxlength="100" /></div>
          <div class="dos-col">
            <div class="campo">
              <label for="fecha">Fecha</label>
              <input id="fecha" name="fecha" type="date" value={v.fecha} required disabled={t.reservas > 0} />
              {t.reservas > 0 && <><input type="hidden" name="fecha" value={v.fecha} /><small>Tiene reservas: la fecha ya no se cambia.</small></>}
            </div>
            <fieldset class="campo">
              <legend>Franja</legend>
              <label class="casilla"><input type="radio" name="momento" value="manana" checked={v.momento === 'manana'} disabled={t.reservas > 0} /> Mañana</label>
              <label class="casilla"><input type="radio" name="momento" value="tarde" checked={v.momento !== 'manana'} disabled={t.reservas > 0} /> Tarde</label>
              {t.reservas > 0 && <input type="hidden" name="momento" value={v.momento} />}
            </fieldset>
          </div>
          <div class="dos-col">
            <div class="campo"><label for="hora_inicio">Empieza</label><input id="hora_inicio" name="hora_inicio" type="time" value={v.hora_inicio} /></div>
            <div class="campo"><label for="hora_fin">Termina</label><input id="hora_fin" name="hora_fin" type="time" value={v.hora_fin} /></div>
          </div>
          <div class="dos-col">
            <div class="campo"><label for="precio">Precio por persona (€)</label><input id="precio" name="precio" inputmode="decimal" value={v.precio} /></div>
            <div class="campo"><label for="plazas">Plazas</label><input id="plazas" name="plazas" type="number" min={Math.max(1, ocupadas)} max="30" value={v.plazas} required /></div>
          </div>
          <div class="campo"><label for="texto">Texto para la web</label><textarea id="texto" name="texto" rows="5" maxlength="3000">{v.texto}</textarea></div>
          <div class="campo"><label for="materiales">Materiales</label><input id="materiales" name="materiales" value={v.materiales} maxlength="200" placeholder="Material incluido" /></div>
          <div class="campo"><label for="datos_pago">Cómo se paga</label><input id="datos_pago" name="datos_pago" value={v.datos_pago} maxlength="300" placeholder="Bizum al 600 000 000" /></div>
          <div class="campo">
            <label for="foto">{t.foto ? 'Cambiar la foto' : 'Foto'}</label>
            <input id="foto" name="foto" type="file" accept="image/jpeg,image/png,image/webp" />
          </div>
          <div class="botones">
            <button class="boton" type="submit">Guardar cambios</button>
            <a class="boton boton--borde" href={`/panel/talleres/${id}`}>Cancelar</a>
          </div>
        </form>
      </details>

      <h3 id="apuntadas">Personas apuntadas ({ocupadas} de {t.plazas} plazas)</h3>
      {apuntadas.length === 0 ? <p class="vacio">Todavía no se ha apuntado nadie.</p> : (
        <ul class="lista-apuntadas">
          {apuntadas.map((a) => (
            <li class="tarjeta apuntada">
              <div>
                <strong>{a.nombre}</strong> · {a.plazas} {a.plazas === 1 ? 'plaza' : 'plazas'}<br />
                <small><a href={`tel:${a.telefono}`}>{a.telefono}</a> · <a href={`mailto:${a.email}`}>{a.email}</a></small><br />
                <span class={`estado estado--${a.estado}`}>{ESTADOS_RESERVA[a.estado]}</span>
                {a.estado === 'pendiente' && a.caduca_en && <small> · hasta {fecha(a.caduca_en)}</small>}
              </div>
              <form method="post" class="apuntada__acciones">
                <input type="hidden" name="reserva" value={a.id} />
                {a.estado === 'pendiente' && <button class="boton" name="accion" value="pagado" type="submit">Pago recibido</button>}
                <button class="boton-texto boton-texto--peligro" name="accion" value="cancelar" type="submit" onclick="return confirm('¿Cancelar esta reserva? La plaza quedará libre.')">Cancelar</button>
                <a class="boton-texto" href={`/panel/reservas/${a.id}`}>Editar</a>
              </form>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="tarjeta">
      <h2>Acciones</h2>

      {t.tallerista_id && (
        <form method="post" class="accion">
          <input type="hidden" name="accion" value="pago" />
          <input type="hidden" name="valor" value={t.pago_reserva_recibido ? '0' : '1'} />
          <p>25 € de la reserva: <strong>{t.pago_reserva_recibido ? 'recibidos' : 'pendientes'}</strong></p>
          <button class="boton boton--borde" type="submit">{t.pago_reserva_recibido ? 'Marcar como no recibidos' : 'Marcar como recibidos'}</button>
        </form>
      )}

      <form method="post" class="accion">
        <input type="hidden" name="accion" value="evento" />
        <p>Evento especial (Halloween, Navidad…): <strong>{t.es_evento ? 'sí' : 'no'}</strong></p>
        <button class="boton-texto" type="submit">{t.es_evento ? 'Quitar marca de evento' : 'Marcar como evento especial'}</button>
      </form>

      {(t.estado === 'enviado' || t.estado === 'hueco') && (
        <form method="post" class="accion">
          <input type="hidden" name="accion" value="publicar" />
          <button class="boton" type="submit" disabled={!completo(t)}>Publicar en la web</button>
          {!completo(t) && <small>Se podrá publicar cuando la tallerista envíe todos los datos.</small>}
        </form>
      )}
      {t.estado === 'publicado' && (
        <p class="calendario"><small>{calendarioActivo()
          ? (t.google_evento ? 'Está en tu Google Calendar, con las apuntadas al día.' : 'Añadiéndose a tu Google Calendar…')
          : 'Google Calendar todavía sin conectar.'}</small></p>
      )}
      {t.estado === 'publicado' && (
        <form method="post" class="accion">
          <input type="hidden" name="accion" value="desactivar" />
          <button class="boton boton--borde" type="submit">Desactivar (quitar de la web)</button>
        </form>
      )}
      {t.estado === 'desactivado' && (
        <form method="post" class="accion">
          <input type="hidden" name="accion" value="reactivar" />
          <button class="boton boton--borde" type="submit">Reactivar</button>
        </form>
      )}

      {enlace && (
        <div class="enlace">
          <h3>Enlace privado {t.tallerista_id ? 'de la tallerista' : '(para rellenar tú)'}</h3>
          <p><input readonly value={enlace} aria-label="Enlace privado" onclick="this.select()" /></p>
          <div class="botones">
            <button class="boton boton--borde" type="button" data-copiar={enlace}>Copiar enlace</button>
            {t.tallerista_id && <a class="boton" href={whatsapp} target="_blank" rel="noopener">Enviar por WhatsApp</a>}
          </div>
          {t.tallerista_id && !tel && <small>No tenemos su teléfono: WhatsApp te dejará elegir el contacto.</small>}
          <form method="post" class="accion">
            <input type="hidden" name="accion" value="enlace" />
            <button class="enlace-nuevo" type="submit">Generar un enlace nuevo (el anterior deja de funcionar)</button>
          </form>
        </div>
      )}

      {t.estado !== 'publicado' && t.reservas === 0 && (
        <form method="post" class="accion peligro" onsubmit="return confirm('¿Eliminar este hueco? No se puede deshacer.')">
          <input type="hidden" name="accion" value="eliminar" />
          <button class="enlace-nuevo" type="submit">Eliminar hueco</button>
        </form>
      )}
    </section>
  </div>
</Panel>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach((b) => {
    b.addEventListener('click', async () => {
      await navigator.clipboard.writeText(b.dataset.copiar ?? '');
      b.textContent = '¡Copiado!';
    });
  });
</script>

<style>
  .cabecera-taller { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .ficha-panel { display: grid; gap: 20px; }
  @media (min-width: 900px) { .ficha-panel { grid-template-columns: 1.4fr 1fr; align-items: start; } }
  .foto-taller { border-radius: 12px; max-height: 320px; object-fit: cover; width: 100%; margin-bottom: 12px; }
  .datos { display: grid; grid-template-columns: max-content 1fr; gap: 6px 16px; }
  .datos dt { font-weight: 700; color: var(--tinta-suave); }
  .datos dd { margin: 0; overflow-wrap: anywhere; }
  .texto { white-space: pre-line; margin-top: 12px; }
  .accion { margin-bottom: 16px; display: grid; gap: 6px; justify-items: start; }
  .accion p { margin: 0; }
  .enlace { border-top: 1px solid var(--borde); padding-top: 12px; margin-top: 8px; }
  .enlace h3 { font-size: 1.05rem; }
  .enlace input { font-size: 0.9rem; }
  .enlace .botones { margin-bottom: 8px; }
  .enlace-nuevo { background: none; border: 0; padding: 0; color: var(--tinta-suave); text-decoration: underline; cursor: pointer; font: inherit; font-size: 0.9rem; }
  .peligro .enlace-nuevo { color: var(--aviso); }
</style>
