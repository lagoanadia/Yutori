---
// Ficha de una persona: contacto, resumen y todo su historial (reservas y peticiones) en una pantalla.
export const prerender = false;
import Panel from '../../../layouts/Panel.astro';
import { ESTADOS_RESERVA, ESTADOS_SOLICITUD, ESTADOS_TALLERISTA, eurosCorto, fecha } from '../../../lib/db';
import { ETIQUETAS, historialDe, listarPersonas } from '../../../lib/personas';
import { telefonoWhatsApp } from '../../../lib/util';

const email = decodeURIComponent(Astro.params.email ?? '').toLowerCase();
const p = (await listarPersonas()).find((x) => x.email === email);
if (!p) return new Response('No encontrada', { status: 404 });
const historial = await historialDe(email);
const wa = telefonoWhatsApp(p.telefono);
const iniciales = p.nombre.split(/\s+/).filter(Boolean).slice(0, 2).map((x) => x[0]).join('').toUpperCase();
const estado = (m: (typeof historial)[number]) => (m.tipo === 'reserva' ? ESTADOS_RESERVA[m.estado] : ESTADOS_SOLICITUD[m.estado]) ?? m.estado;
---
<Panel titulo={p.nombre} ocultarTitulo>
  <p><a href="/panel/personas">← Personas</a></p>

  <header class="ficha-persona tarjeta">
    <span class:list={['avatar', { 'avatar--tallerista': p.tallerista }]} aria-hidden="true">{iniciales}</span>
    <div class="ficha-persona__texto">
      <h1>{p.nombre}</h1>
      <p class="etiquetas">{p.etiquetas.map((e) => <span class={`etiqueta-p etiqueta-p--${e}`}>{ETIQUETAS[e]}</span>)}</p>
      <p class="contacto-datos">{p.email}{p.telefono && ` · ${p.telefono}`}</p>
    </div>
    <div class="ficha-persona__botones">
      {wa && <a class="boton" href={`https://wa.me/${wa}`} target="_blank" rel="noopener">WhatsApp</a>}
      {p.telefono && <a class="boton boton--borde" href={`tel:${p.telefono}`}>Llamar</a>}
      <a class="boton boton--borde" href={`mailto:${p.email}`}>Email</a>
    </div>
  </header>

  <ul class="cifras">
    <li><strong>{eurosCorto(p.gastoCent)}</strong><span>pagado en total</span></li>
    <li><strong>{p.reservas}</strong><span>{p.reservas === 1 ? 'reserva' : 'reservas'}</span></li>
    <li class:list={{ alerta: p.pendientes > 0 }}><strong>{p.pendientes}</strong><span>sin pagar</span></li>
    <li><strong>{fecha(p.primera.slice(0, 10)).replace(/^[^,]+, /, '')}</strong><span>primera vez</span></li>
  </ul>

  {p.tallerista && (
    <p class="tarjeta aviso-tallerista">
      Tallerista{p.tallerista.marca && ` (${p.tallerista.marca})`} · {ESTADOS_TALLERISTA[p.tallerista.estado]}
      <a class="boton boton--borde" href={`/panel/talleristas/${p.tallerista.id}`}>Ver su ficha de tallerista</a>
    </p>
  )}

  <h2>Historial</h2>
  {historial.length === 0 ? <p class="vacio">Sin reservas ni peticiones.</p> : (
    <ol class="historial">
      {historial.map((m) => (
        <li class:list={['movimiento', `movimiento--${m.tipo}`]}>
          <a href={m.href}>
            <span class="movimiento__cuando">{fecha(m.cuando)}</span>
            <strong>{m.titulo}</strong>
            {m.detalle && <small>{m.detalle}</small>}
          </a>
          <span class="movimiento__lado">
            {m.importeCent != null && m.importeCent > 0 && <strong>{eurosCorto(m.importeCent)}</strong>}
            <span class={`estado estado--${m.estado}`}>{estado(m)}</span>
          </span>
        </li>
      ))}
    </ol>
  )}
</Panel>

<style>
  .ficha-persona { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; margin-bottom: 12px; }
  .ficha-persona h1 { margin: 0; }
  .ficha-persona__texto { flex: 1 1 240px; min-width: 0; }
  .ficha-persona__texto p { margin: 4px 0 0; }
  .contacto-datos { color: var(--tinta-suave); overflow-wrap: anywhere; }
  .ficha-persona__botones { display: flex; flex-wrap: wrap; gap: 8px; }
  .avatar { flex: none; width: 64px; height: 64px; font-size: 1.3rem; border-radius: 50%; display: grid; place-items: center; font-weight: 800; background: var(--salvia-suave); color: var(--verde-profundo); }
  .avatar--tallerista { background: #f6eadb; color: var(--oro); }
  .etiquetas { display: flex; flex-wrap: wrap; gap: 4px; }
  .etiqueta-p { font-size: 0.75rem; font-weight: 700; padding: 1px 8px; border-radius: 99px; background: var(--salvia-suave); color: var(--verde-profundo); }
  .etiqueta-p--tallerista, .etiqueta-p--talleres { background: #f6eadb; color: #7a5a22; }
  .etiqueta-p--privado, .etiqueta-p--bono { background: #ece4f3; color: #5b4370; }
  .cifras { list-style: none; padding: 0; margin: 0 0 16px; display: grid; gap: 10px; grid-template-columns: repeat(2, 1fr); }
  .cifras li { background: var(--crema-claro); border: 1px solid var(--borde); border-radius: var(--radio); padding: 12px 14px; display: flex; flex-direction: column; }
  .cifras strong { font-family: var(--serif); font-size: 1.6rem; line-height: 1.1; color: var(--verde-profundo); }
  .cifras span { font-size: 0.85rem; color: var(--tinta-suave); }
  .cifras .alerta strong { color: var(--aviso); }
  @media (min-width: 760px) { .cifras { grid-template-columns: repeat(4, 1fr); } }
  .aviso-tallerista { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; }
  .historial { list-style: none; padding: 0; margin: 0; border-left: 2px solid var(--borde); margin-left: 8px; }
  .movimiento { position: relative; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 0 10px 18px; }
  .movimiento::before { content: ''; position: absolute; left: -7px; top: 18px; width: 12px; height: 12px; border-radius: 50%; background: var(--verde); border: 2px solid var(--crema); }
  .movimiento--solicitud::before { background: #8a6aa8; }
  .movimiento a { display: flex; flex-direction: column; color: inherit; text-decoration: none; min-width: 0; }
  .movimiento a:hover strong { text-decoration: underline; }
  .movimiento small, .movimiento__cuando { color: var(--tinta-suave); font-size: 0.82rem; }
  .movimiento__lado { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; flex: none; }
</style>
