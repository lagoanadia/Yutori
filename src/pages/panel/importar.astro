---
export const prerender = false;
import Panel from '../../layouts/Panel.astro';
import { importar, MAX_BYTES, MAX_FILAS, preparar, TIPOS_IMPORTAR, type Preparado, type Tipo } from '../../lib/importar';

const errores: string[] = [];
const okN = Astro.url.searchParams.get('ok');
let tipo: Tipo | null = null;
let texto = '';
let prep: Preparado | null = null;

if (Astro.request.method === 'POST') {
  const datos = await Astro.request.formData();
  const elegido = String(datos.get('tipo') ?? '');
  const confirmar = datos.get('confirmar') === '1';
  const archivo = datos.get('archivo');

  if (elegido in TIPOS_IMPORTAR) tipo = elegido as Tipo;
  else errores.push('Elige qué quieres importar.');

  // Al confirmar llega el texto que ya revisaste (en un campo oculto); si no, viene de lo pegado o del archivo.
  if (confirmar) {
    texto = String(datos.get('texto') ?? '');
  } else if (archivo instanceof File && archivo.size > 0) {
    if (archivo.size > MAX_BYTES) errores.push('El archivo pesa más de 1 MB.');
    else texto = await archivo.text();
  } else {
    texto = String(datos.get('texto') ?? '');
  }

  if (tipo && !errores.length) {
    if (!texto.trim()) {
      errores.push('No hay datos: pega las filas o sube un archivo.');
    } else {
      prep = await preparar(tipo, texto);
      if (prep.validas.length > MAX_FILAS) errores.push(`Son ${prep.validas.length} filas: como máximo se importan ${MAX_FILAS} de una vez.`);
      else if (prep.validas.length === 0 && prep.errores.length === 0) {
        errores.push('No hay filas nuevas: todas ya existían o el texto está vacío.');
      }
    }
  }

  // Solo se guarda cuando confirmas y no hay ningún error: si algo falla, no entra nada.
  if (confirmar && prep && tipo && !errores.length && !prep.errores.length) {
    const n = await importar(tipo, prep.validas);
    return Astro.redirect(`/panel/importar?ok=${n}`, 303);
  }
}
---
<Panel titulo="Importar datos">
  <p><a href="/panel">← Resumen</a></p>
  <p class="intro">
    Pega aquí lo que tengas en tu hoja de cálculo (copia las filas con la primera fila de nombres de columna) o sube un CSV.
    Nada se guarda hasta que confirmes la vista previa. Las filas que ya existan (mismo nombre y email) se saltan.
  </p>

  {okN && <div class="aviso-ok" role="status">Importadas {okN} filas.</div>}

  {errores.length > 0 && <div class="errores" role="alert"><ul>{errores.map((e) => <li>{e}</li>)}</ul></div>}

  {prep && prep.errores.length > 0 && (
    <div class="errores" role="alert">
      <p><strong>Corrige estas filas y vuelve a revisar. Ninguna se ha guardado:</strong></p>
      <ul>{prep.errores.map((e) => <li>{e}</li>)}</ul>
    </div>
  )}

  {prep && prep.validas.length > 0 && prep.errores.length === 0 && (
    <section>
      <h2>Vista previa</h2>
      <p>Se importarán <strong>{prep.validas.length}</strong> filas{prep.repetidas > 0 && <> · {prep.repetidas} repetidas, se saltan</>}.</p>
      <table class="tabla">
        <thead><tr>{prep.cabecera.map((c) => <th>{c}</th>)}</tr></thead>
        <tbody>
          {prep.validas.slice(0, 50).map((f) => (
            <tr>{f.vista.map((c, i) => <td data-label={prep!.cabecera[i]}>{c}</td>)}</tr>
          ))}
        </tbody>
      </table>
      {prep.validas.length > 50 && <p><small>Se muestran las 50 primeras.</small></p>}

      <form method="post" class="botones">
        <input type="hidden" name="tipo" value={tipo!} />
        <input type="hidden" name="confirmar" value="1" />
        <textarea name="texto" hidden>{texto}</textarea>
        <button class="boton" type="submit">Importar {prep.validas.length} filas</button>
      </form>
    </section>
  )}

  <form method="post" enctype="multipart/form-data" class="formulario tarjeta">
    <div class="campo">
      <label for="tipo">Qué quieres importar</label>
      <select id="tipo" name="tipo" required>
        {Object.entries(TIPOS_IMPORTAR).map(([k, v]) => <option value={k} selected={tipo === k}>{v}</option>)}
      </select>
    </div>
    <div class="campo">
      <label for="texto">Pega las filas</label>
      <textarea id="texto" name="texto" rows="10" placeholder="nombre	email	propuesta&#10;Lucía	lucia@ejemplo.com	Grabado en tote bags">{texto}</textarea>
      <small>Copia desde la hoja de cálculo (con tabuladores) o escribe un CSV con ; o , como separador.</small>
    </div>
    <div class="campo">
      <label for="archivo">…o sube un CSV</label>
      <input id="archivo" name="archivo" type="file" accept=".csv,text/csv" />
    </div>
    <button class="boton" type="submit">Revisar</button>
  </form>
</Panel>
