---
export const prerender = false;
import Panel from '../../layouts/Panel.astro';
import { z } from 'zod';
import { importar, leerEntrada, MAX_BYTES, MAX_FILAS, preparar, type Entrada, type Preparado } from '../../lib/importar';

const errores: string[] = [];
const okN = Astro.url.searchParams.get('ok');
let texto = '';
let prep: Preparado | null = null;
let entrada: Entrada | null = null;

// Lo que llega al confirmar: las filas ya separadas, tal como se enseñaron en la vista previa.
const entradaGuardada = z.object({
  tipo: z.enum(['talleristas', 'solicitudes', 'clases']),
  filas: z.array(z.record(z.string(), z.string())).max(MAX_FILAS),
});

if (Astro.request.method === 'POST') {
  const datos = await Astro.request.formData();
  const confirmar = datos.get('confirmar') === '1';
  const archivo = datos.get('archivo');

  if (confirmar) {
    const leida = entradaGuardada.safeParse(JSON.parse(String(datos.get('entrada') ?? '{}')));
    if (leida.success) entrada = leida.data;
    else errores.push('No se han podido leer las filas. Vuelve a revisar el texto.');
  } else {
    if (archivo instanceof File && archivo.size > 0) {
      if (archivo.size > MAX_BYTES) errores.push('El archivo pesa más de 1 MB.');
      else texto = await archivo.text();
    } else {
      texto = String(datos.get('texto') ?? '');
    }
    if (!errores.length && !texto.trim()) errores.push('No hay datos: pega el texto o sube un archivo.');
    if (!errores.length) {
      try {
        entrada = await leerEntrada(texto);
      } catch (e) {
        errores.push(e instanceof Error ? e.message : 'No se ha podido leer el texto.');
      }
    }
  }

  if (entrada && !errores.length) {
    prep = await preparar(entrada);
    if (prep.validas.length > MAX_FILAS) errores.push(`Son ${prep.validas.length} filas: como máximo se importan ${MAX_FILAS} de una vez.`);
    else if (prep.validas.length === 0 && prep.errores.length === 0) {
      errores.push('No hay filas nuevas: todas ya existían o no se ha encontrado ninguna persona en el texto.');
    }
  }

  // Solo se guarda al confirmar y sin ningún error: si algo falla, no entra nada.
  if (confirmar && entrada && prep && !errores.length && !prep.errores.length) {
    const n = await importar(entrada.tipo, prep.validas);
    return Astro.redirect(`/panel/importar?ok=${n}`, 303);
  }
}
---
<Panel titulo="Importar datos">
  <p><a href="/panel">← Resumen</a></p>
  <p class="intro">
    Pega lo que tengas, tal cual: una tabla copiada de la hoja de cálculo, una lista o mensajes con los datos.
    Si las columnas tienen nombre (nombre, email…) se leen directamente; si no, la IA separa las personas por ti.
    Nada se guarda hasta que confirmes la vista previa. Las personas que ya existan (mismo nombre y email) se saltan.
  </p>

  {okN && <div class="aviso-ok" role="status">Importadas {okN} filas.</div>}

  {errores.length > 0 && <div class="errores" role="alert"><ul>{errores.map((e) => <li>{e}</li>)}</ul></div>}

  {prep && prep.errores.length > 0 && (
    <div class="errores" role="alert">
      <p><strong>Corrige estas filas y vuelve a revisar. Ninguna se ha guardado:</strong></p>
      <ul>{prep.errores.map((e) => <li>{e}</li>)}</ul>
    </div>
  )}

  {prep && entrada && prep.validas.length > 0 && prep.errores.length === 0 && (
    <section>
      <h2>Vista previa</h2>
      <p>
        Se importarán <strong>{prep.validas.length}</strong> {entrada.tipo === 'talleristas' ? 'talleristas' : entrada.tipo === 'clases' ? 'horarios' : 'privados o bonos'}
        {prep.repetidas > 0 && <> · {prep.repetidas} repetidas, se saltan</>}.
      </p>
      <table class="tabla">
        <thead><tr>{prep.cabecera.map((c) => <th>{c}</th>)}</tr></thead>
        <tbody>
          {prep.validas.slice(0, 50).map((f) => (
            <tr>{f.vista.map((c, i) => <td data-label={prep!.cabecera[i]}>{c}</td>)}</tr>
          ))}
        </tbody>
      </table>
      {prep.validas.length > 50 && <p><small>Se muestran las 50 primeras.</small></p>}

      <form method="post" class="botones">
        <input type="hidden" name="confirmar" value="1" />
        <textarea name="entrada" hidden>{JSON.stringify(entrada)}</textarea>
        <button class="boton" type="submit">Importar {prep.validas.length} filas</button>
      </form>
    </section>
  )}

  <form method="post" enctype="multipart/form-data" class="formulario tarjeta">
    <div class="campo">
      <label for="texto">Pega aquí los datos</label>
      <textarea id="texto" name="texto" rows="10">{texto}</textarea>
      <small>Puedes pegar una tabla de la hoja de cálculo, una lista o mensajes con los datos.</small>
    </div>
    <div class="campo">
      <label for="archivo">…o sube un archivo CSV</label>
      <input id="archivo" name="archivo" type="file" accept=".csv,text/csv" />
    </div>
    <button class="boton" type="submit">Revisar</button>
  </form>
</Panel>
