---
export const prerender = false;
import Panel from '../../../layouts/Panel.astro';
import { db, todos, uno, fecha, FRANJAS, ESTADOS_TALLER, ESTADOS_TALLERISTA } from '../../../lib/db';
import { borrarFoto, urlFoto } from '../../../lib/fotos';
import { mapaCategorias, mensajes, mapearTallerista } from '../../../lib/importar';
import CamposTallerista from '../../../components/panel/CamposTallerista.astro';

const id = Number(Astro.params.id);
type Tallerista = {
  id: number; nombre: string; marca: string | null; instagram: string | null; email: string; telefono: string | null;
  categoria_id: number | null; categoria: string | null; propuesta: string; fotos: string; ha_impartido: number | null;
  autonoma: number | null; estado: string; notas: string | null; creado_en: string;
};
const cargar = () => uno<Tallerista>(
  'SELECT ta.*, c.nombre AS categoria FROM talleristas ta LEFT JOIN categorias c ON c.id = ta.categoria_id WHERE ta.id = ?1', id);

let t = Number.isInteger(id) ? await cargar() : null;
if (!t) return new Response('No encontrada', { status: 404 });

const errores: string[] = [];
let editando: Record<string, string> | null = null;

if (Astro.request.method === 'POST') {
  const datos = await Astro.request.formData();
  const accion = String(datos.get('accion') ?? '');

  if (accion === 'datos') {
    // Mismas reglas que al añadirla: nombre, email y propuesta obligatorios, categoría existente…
    const v = Object.fromEntries([...datos.entries()].filter(([, x]) => typeof x === 'string').map(([k, x]) => [k, String(x).trim()]));
    const { datos: d, errores: e } = mapearTallerista({ ...v, estado: t.estado }, await mapaCategorias());
    if (d) {
      await db().prepare(`UPDATE talleristas SET nombre = ?1, marca = ?2, instagram = ?3, email = ?4, telefono = ?5, categoria_id = ?6,
                          propuesta = ?7, ha_impartido = ?8, autonoma = ?9 WHERE id = ?10`)
        .bind(d.nombre, d.marca, d.instagram, d.email, d.telefono, d.categoria_id, d.propuesta, d.ha_impartido, d.autonoma, id).run();
      return Astro.redirect(`/panel/talleristas/${id}?ok=guardado`, 303);
    }
    errores.push(...mensajes(e));
    editando = v;
  }

  if (accion === 'eliminar') {
    const talleres = await uno<{ n: number }>('SELECT count(*) AS n FROM talleres WHERE tallerista_id = ?1', id);
    if ((talleres?.n ?? 0) > 0) errores.push('Tiene talleres: no se puede eliminar. Márcala como descartada si ya no trabajáis juntas.');
    else {
      await db().prepare('DELETE FROM talleristas WHERE id = ?1').bind(id).run();
      for (const f of JSON.parse(t.fotos || '[]') as string[]) await borrarFoto(f);
      return Astro.redirect('/panel/talleristas?ok=eliminado', 303);
    }
  }

  if (accion === 'decision') {
    const estado = String(datos.get('estado') ?? '');
    const notas = String(datos.get('notas') ?? '').trim().slice(0, 3000);
    if (estado in ESTADOS_TALLERISTA) {
      await db().prepare('UPDATE talleristas SET estado = ?1, notas = ?2 WHERE id = ?3').bind(estado, notas || null, id).run();
    }
    return Astro.redirect(`/panel/talleristas/${id}?ok=guardado`, 303);
  }
}

const siNoTexto = (x: number | null) => (x == null ? '' : x ? 'si' : 'no');
const valores = editando ?? {
  nombre: t.nombre, marca: t.marca ?? '', email: t.email, telefono: t.telefono ?? '', instagram: t.instagram ?? '',
  categoria: t.categoria ?? '', propuesta: t.propuesta, ha_impartido: siNoTexto(t.ha_impartido), autonoma: siNoTexto(t.autonoma),
};
const categorias = (await todos<{ nombre: string }>('SELECT nombre FROM categorias ORDER BY nombre')).map((c) => c.nombre);

const fotos: string[] = JSON.parse(t.fotos || '[]');
const otrasAceptadas = t.categoria_id
  ? await todos<{ id: number; nombre: string; marca: string | null }>(
      `SELECT id, nombre, marca FROM talleristas WHERE estado = 'aceptada' AND categoria_id = ?1 AND id <> ?2`, t.categoria_id, id)
  : [];
const susTalleres = await todos<{ id: number; titulo: string | null; fecha: string; franja: string; estado: string }>(
  'SELECT id, titulo, fecha, franja, estado FROM talleres WHERE tallerista_id = ?1 ORDER BY fecha DESC', id);
const siNo = (v: number | null) => (v == null ? '—' : v ? 'Sí' : 'No');
---
<Panel titulo={t.marca ? `${t.nombre} · ${t.marca}` : t.nombre}>
  <p><a href="/panel/talleristas">← Todas las talleristas</a></p>

  {errores.length > 0 && <div class="errores" role="alert"><ul>{errores.map((e) => <li>{e}</li>)}</ul></div>}

  {otrasAceptadas.length > 0 && (
    <p class="errores">
      La categoría <strong>{t.categoria}</strong> ya está cubierta por {otrasAceptadas.map((o) => o.marca ?? o.nombre).join(', ')}.
      Puedes dejarla "En reserva" por si algún día hace falta.
    </p>
  )}

  <div class="ficha-panel">
    <section class="tarjeta">
      <h2>Propuesta</h2>
      <p class="propuesta">{t.propuesta}</p>
      <dl class="datos">
        <dt>Categoría</dt><dd>{t.categoria ?? '—'}</dd>
        <dt>Email</dt><dd><a href={`mailto:${t.email}`}>{t.email}</a></dd>
        <dt>Teléfono</dt><dd>{t.telefono ? <a href={`tel:${t.telefono}`}>{t.telefono}</a> : '—'}</dd>
        <dt>Instagram</dt><dd>{t.instagram ?? '—'}</dd>
        <dt>Ha dado talleres</dt><dd>{siNo(t.ha_impartido)}</dd>
        <dt>Autónoma</dt><dd>{siNo(t.autonoma)}</dd>
        <dt>Llegó</dt><dd>{fecha(t.creado_en)}</dd>
      </dl>
      {fotos.length > 0 && (
        <div class="fotos">
          {fotos.map((f) => <a href={urlFoto(f)} target="_blank"><img src={urlFoto(f)} alt="Foto enviada por la tallerista" loading="lazy" /></a>)}
        </div>
      )}

      <details class="editar" open={Boolean(editando)}>
        <summary class="boton boton--borde">Editar datos</summary>
        <form method="post" class="formulario">
          <input type="hidden" name="accion" value="datos" />
          <CamposTallerista v={valores} categorias={categorias} conEstado={false} />
          <div class="botones">
            <button class="boton" type="submit">Guardar cambios</button>
            <a class="boton boton--borde" href={`/panel/talleristas/${id}`}>Cancelar</a>
          </div>
        </form>
        {susTalleres.length === 0 && (
          <form method="post" class="eliminar">
            <input type="hidden" name="accion" value="eliminar" />
            <button class="boton-texto boton-texto--peligro" type="submit" onclick="return confirm('¿Eliminar esta tallerista? No se puede deshacer.')">Eliminar tallerista</button>
          </form>
        )}
      </details>
    </section>

    <section class="tarjeta">
      <h2>Tu decisión</h2>
      <form method="post" class="formulario">
        <input type="hidden" name="accion" value="decision" />
        <div class="campo">
          <label for="estado">Estado</label>
          <select id="estado" name="estado">
            {Object.entries(ESTADOS_TALLERISTA).map(([k, v]) => <option value={k} selected={k === t.estado}>{v}</option>)}
          </select>
        </div>
        <div class="campo">
          <label for="notas">Notas privadas</label>
          <textarea id="notas" name="notas" rows="4" maxlength="3000">{t.notas}</textarea>
        </div>
        <button class="boton" type="submit">Guardar</button>
      </form>

      {t.estado === 'aceptada' && (
        <p class="crear"><a class="boton boton--borde" href={`/panel/talleres/nuevo?tallerista=${t.id}`}>Crear hueco de taller</a></p>
      )}

      <h3>Sus talleres</h3>
      {susTalleres.length === 0 ? <p class="vacio">Todavía ninguno.</p> : (
        <ul class="sus-talleres">
          {susTalleres.map((s) => (
            <li><a href={`/panel/talleres/${s.id}`}>{fecha(s.fecha)} · {FRANJAS[s.franja]}</a> — {s.titulo ?? 'sin título aún'} <span class={`estado estado--${s.estado}`}>{ESTADOS_TALLER[s.estado]}</span></li>
          ))}
        </ul>
      )}
    </section>
  </div>
</Panel>

<style>
  .ficha-panel { display: grid; gap: 20px; }
  @media (min-width: 900px) { .ficha-panel { grid-template-columns: 1.4fr 1fr; align-items: start; } }
  .propuesta { white-space: pre-line; }
  .datos { display: grid; grid-template-columns: max-content 1fr; gap: 6px 16px; margin: 16px 0; }
  .datos dt { font-weight: 700; color: var(--tinta-suave); }
  .datos dd { margin: 0; overflow-wrap: anywhere; }
  .fotos { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 8px; }
  .fotos img { aspect-ratio: 1; object-fit: cover; border-radius: 10px; width: 100%; }
  .crear { margin-top: 16px; }
  .sus-talleres { padding-left: 1.2em; }
  .sus-talleres li { margin-bottom: 8px; }
</style>
