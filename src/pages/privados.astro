---
import Base from '../layouts/Base.astro';
import { categorias } from '../data/yutori';
---
<Base titulo="Talleres privados" descripcion="Talleres privados en A Coruña para despedidas, cumpleaños, grupos y empresas.">
  <section class="seccion">
    <div class="contenedor">
      <p class="script">Solo para vosotras</p>
      <h1>Talleres privados</h1>
      <p class="intro">Despedidas, cumpleaños, grupos de amigas o empresas. Cada taller privado es distinto: cuéntanos qué buscáis y os proponemos fecha, taller y precio.</p>

      <form class="formulario" data-prototipo>
        <div class="dos-col">
          <div class="campo"><label for="nombre">Nombre</label><input id="nombre" name="nombre" autocomplete="name" required /></div>
          <div class="campo"><label for="tel">Teléfono</label><input id="tel" name="tel" type="tel" autocomplete="tel" required /></div>
        </div>
        <div class="campo"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
        <div class="dos-col">
          <div class="campo">
            <label for="motivo">¿Qué celebráis?</label>
            <select id="motivo" name="motivo">
              <option>Despedida</option>
              <option>Cumpleaños</option>
              <option>Grupo de amigas</option>
              <option>Empresa</option>
              <option>Otro</option>
            </select>
          </div>
          <div class="campo">
            <label for="categoria">Tipo de taller</label>
            <select id="categoria" name="categoria">
              <option value="">Aún no lo sé</option>
              {categorias.map((c) => <option>{c}</option>)}
            </select>
          </div>
        </div>
        <div class="dos-col">
          <div class="campo"><label for="fecha">Fecha aproximada</label><input id="fecha" name="fecha" type="date" /></div>
          <div class="campo"><label for="personas">Número de personas</label><input id="personas" name="personas" type="number" min="1" inputmode="numeric" /></div>
        </div>
        <div class="campo"><label for="mensaje">Cuéntanos un poco más</label><textarea id="mensaje" name="mensaje" rows="4"></textarea></div>
        <label class="casilla"><input type="checkbox" required /> Acepto la <a href="/privacidad">política de privacidad</a>.</label>
        <button class="boton" type="submit">Pedir información</button>
        <p class="aviso-prototipo" data-resultado hidden>Prototipo: todavía no se envía nada. En el bloque 6 esta solicitud llegará al panel y al email de Iris.</p>
      </form>
    </div>
  </section>
</Base>
