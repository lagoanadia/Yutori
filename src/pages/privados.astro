---
export const prerender = false;
import Base from '../layouts/Base.astro';
import Turnstile from '../components/Turnstile.astro';
import { db, todos } from '../lib/db';
import { verificarTurnstile } from '../lib/turnstile';
import { avisoSolicitud } from '../lib/avisos';
import { esEmail, esFecha } from '../lib/util';

const MOTIVOS = ['Despedida', 'Cumpleaños', 'Grupo de amigas', 'Empresa', 'Otro'];
const categorias = await todos<{ id: number; nombre: string }>('SELECT id, nombre FROM categorias WHERE activa = 1 ORDER BY id');

const enviado = Astro.url.searchParams.has('enviado');
const errores: string[] = [];
let v = { nombre: '', telefono: '', email: '', motivo: MOTIVOS[0], fecha: '', personas: '', mensaje: '' };
let tipos: string[] = [];

if (Astro.request.method === 'POST') {
  const datos = await Astro.request.formData();
  const campo = (k: string, max = 160) => String(datos.get(k) ?? '').trim().slice(0, max);
  v = {
    nombre: campo('nombre', 120), telefono: campo('telefono', 30), email: campo('email'), motivo: campo('motivo', 40),
    fecha: campo('fecha', 10), personas: campo('personas', 4), mensaje: campo('mensaje', 2000),
  };
  if (campo('web')) return Astro.redirect('/privados?enviado', 303);

  // Varios tipos de taller a la vez: solo los que existen en la lista.
  tipos = datos.getAll('tipos').map(String).filter((t) => categorias.some((c) => c.nombre === t));
  const personas = v.personas ? Number(v.personas) : null;
  if (!v.nombre) errores.push('Escribe tu nombre.');
  if (v.telefono.replace(/\D/g, '').length < 9) errores.push('Escribe un teléfono de contacto.');
  if (!esEmail(v.email)) errores.push('Escribe un email válido.');
  if (!MOTIVOS.includes(v.motivo)) errores.push('Dinos qué celebráis.');
  if (v.fecha && !esFecha(v.fecha)) errores.push('La fecha no es válida.');
  if (personas !== null && (!Number.isInteger(personas) || personas < 1 || personas > 100)) errores.push('Indica cuántas personas seréis.');
  if (datos.get('privacidad') !== 'on') errores.push('Tienes que aceptar la política de privacidad.');

  if (errores.length === 0 && !(await verificarTurnstile(datos.get('cf-turnstile-response'), Astro.request.headers.get('CF-Connecting-IP')))) {
    errores.push('No hemos podido comprobar que no eres un robot. Vuelve a intentarlo.');
  }

  if (errores.length === 0) {
    await db()
      .prepare(`INSERT INTO solicitudes (tipo, nombre, email, telefono, motivo, tipos_taller, fecha_aprox, personas, mensaje, acepta_privacidad_en)
                VALUES ('privado', ?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8, strftime('%Y-%m-%dT%H:%M:%S', 'now')) RETURNING id`)
      .bind(v.nombre, v.email, v.telefono, v.motivo, tipos.length ? tipos.join(', ') : null, v.fecha || null, personas, v.mensaje || null)
      .first<{ id: number }>()
      .then((fila) => fila && avisoSolicitud(fila.id));
    return Astro.redirect('/privados?enviado', 303);
  }
}
---
<Base titulo="Talleres privados" descripcion="Talleres privados en A Coruña para despedidas, cumpleaños, grupos y empresas.">
  <section class="seccion">
    <div class="contenedor">
      <p class="script">Solo para vosotras</p>
      <h1>Talleres privados</h1>

      {enviado ? (
        <div class="tarjeta gracias" role="status">
          <h2>¡Gracias! Hemos recibido vuestra petición</h2>
          <p>Cada taller privado es distinto: miramos la disponibilidad de las artesanas y os escribimos con una propuesta de fecha, taller y precio.</p>
          <a class="boton boton--borde" href="/talleres">Ver los talleres del mes</a>
        </div>
      ) : (
        <>
          <p class="intro">Despedidas, cumpleaños, grupos de amigas o empresas. Cada taller privado es distinto: cuéntanos qué buscáis y os proponemos fecha, taller y precio.</p>
          {errores.length > 0 && <div class="errores" role="alert"><p><strong>Revisa estos datos:</strong></p><ul>{errores.map((e) => <li>{e}</li>)}</ul></div>}

          <form class="formulario" method="post">
            <div class="dos-col">
              <div class="campo"><label for="nombre">Nombre</label><input id="nombre" name="nombre" autocomplete="name" maxlength="120" value={v.nombre} required /></div>
              <div class="campo"><label for="telefono">Teléfono</label><input id="telefono" name="telefono" type="tel" autocomplete="tel" maxlength="30" value={v.telefono} required /></div>
            </div>
            <div class="campo"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" maxlength="160" value={v.email} required /></div>
            <div class="campo">
              <label for="motivo">¿Qué celebráis?</label>
              <select id="motivo" name="motivo">{MOTIVOS.map((m) => <option selected={m === v.motivo}>{m}</option>)}</select>
            </div>
            <fieldset class="campo">
              <legend>Tipo de taller</legend>
              <small>Marca todos los que os apetezcan. Si aún no lo sabéis, déjalo en blanco y os ayudamos a elegir.</small>
              <div class="tipos">
                {categorias.map((c) => <label class="casilla"><input type="checkbox" name="tipos" value={c.nombre} checked={tipos.includes(c.nombre)} /> {c.nombre}</label>)}
              </div>
            </fieldset>
            <div class="dos-col">
              <div class="campo"><label for="fecha">Fecha aproximada</label><input id="fecha" name="fecha" type="date" value={v.fecha} /></div>
              <div class="campo"><label for="personas">Número de personas</label><input id="personas" name="personas" type="number" min="1" max="100" inputmode="numeric" value={v.personas} /></div>
            </div>
            <div class="campo"><label for="mensaje">Cuéntanos un poco más</label><textarea id="mensaje" name="mensaje" rows="4" maxlength="2000">{v.mensaje}</textarea></div>
            <div class="trampa" aria-hidden="true"><label for="web">No rellenes este campo</label><input id="web" name="web" tabindex="-1" autocomplete="off" /></div>
            <label class="casilla"><input type="checkbox" name="privacidad" required /> Acepto la <a href="/privacidad">política de privacidad</a>.</label>
            <Turnstile />
            <button class="boton" type="submit">Pedir información</button>
          </form>
        </>
      )}
    </div>
  </section>
</Base>

<style>
  .gracias { max-width: 640px; }
  .tipos { display: grid; gap: 8px 16px; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
  .gracias h2 { font-size: 1.5rem; }
</style>
