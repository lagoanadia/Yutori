---
// Página privada de cada reserva (el código largo es la llave). Sirve para talleres y para clases.
export const prerender = false;
import Base from '../../layouts/Base.astro';
import { emailUrl, fechaLarga, negocio, politicaClases, politicaTalleres, textosPago } from '../../data/yutori';
import { DIAS, euros, eurosCorto, fecha } from '../../lib/db';
import { bajaAbierta, cambiarMetodoPago, marcarNoRenueva, meses, nombreMes } from '../../lib/clases';
import { reservaPorCodigo } from '../../lib/reservas';
import { confirmarPago, iniciarPago } from '../../lib/pagos';
import { stripeActivo } from '../../lib/stripe';

const codigo = Astro.params.codigo ?? '';
let r = await reservaPorCodigo(codigo);
if (!r) return new Response(null, { status: 404 });

// Vuelta de la página de pago: se confirma aquí también, por si el aviso de Stripe todavía no ha llegado.
const vueltaPago = Astro.url.searchParams.get('pago') === 'ok';
if (vueltaPago && r.estado === 'pendiente' && r.stripe_sesion && stripeActivo()) {
  await confirmarPago(r.stripe_sesion).catch(() => false);
  r = (await reservaPorCodigo(codigo))!;
}

const conTarjeta = stripeActivo();
const renovada = r.tipo === 'clase_mensual' && r.renovada_de != null;
// Plaza renovada que aún no se ha cobrado: se puede elegir tarjeta (si hay una guardada) o efectivo.
const eligeMetodo = renovada && r.estado === 'pendiente' && !r.cobro_intentado_en;
// Hasta el día 25 se puede avisar de que no se sigue el mes siguiente (en la plaza del mes en curso).
const avisoBaja = r.tipo === 'clase_mensual' && r.mes === meses().actual && bajaAbierta() && ['pendiente', 'confirmada'].includes(r.estado);
// Se paga con tarjeta en la web si está pendiente, salvo las renovadas que esperan su cobro del día 1 o van en efectivo sin fallo.
const puedePagar = conTarjeta && r.estado === 'pendiente' && !!r.importe_cent && !(eligeMetodo && r.metodo_pago === 'tarjeta');

if (Astro.request.method === 'POST') {
  const datos = await Astro.request.formData();
  const accion = String(datos.get('accion') ?? '');
  if (accion === 'pagar' && puedePagar) {
    const url = await iniciarPago(codigo, Astro.url.origin).catch(() => null);
    if (url) return Astro.redirect(url, 303);
  } else if ((accion === 'no_renovar' || accion === 'si_renovar') && avisoBaja) {
    await marcarNoRenueva(r.id, accion === 'no_renovar');
  } else if (accion === 'metodo' && eligeMetodo) {
    const metodo = String(datos.get('metodo'));
    if (metodo === 'tarjeta' || metodo === 'efectivo') await cambiarMetodoPago(r.id, metodo);
  }
  return Astro.redirect(`/reserva/${codigo}`, 303);
}

const esTaller = r.tipo === 'taller';
const esMensual = r.tipo === 'clase_mensual';
const mesSiguiente = nombreMes(meses().siguiente);
const quien = r.nombre_menor ? `${r.nombre_menor} (${r.nombre})` : r.nombre;

const importe = r.importe_cent != null && r.tipo !== 'taller' ? `${eurosCorto(r.importe_cent)}${esMensual ? '/mes' : ''}`
  : r.importe_cent != null ? euros(r.importe_cent)
  : r.precio_cent == null ? null
  : esMensual && r.precio_max_cent ? `${r.precio_cent / 100}-${eurosCorto(r.precio_max_cent)}/mes`
  : esMensual ? `${eurosCorto(r.precio_cent)}/mes`
  : euros(r.precio_cent * r.plazas);
const comoPagar = r.datos_pago ?? (negocio.pagoYutori || null);
const concepto = `${(r.nombre_menor ?? r.nombre).split(' ')[0]} · ${r.titulo}`.slice(0, 60);
const cuando = esMensual
  ? `${DIAS[r.dia_semana ?? 0].replace(/([^s])$/, '$1s')} de ${r.hora_inicio} a ${r.hora_fin}, ${nombreMes(r.mes!)}`
  : `${fechaLarga(r.fecha!)}, de ${r.hora_inicio} a ${r.hora_fin}`;
const politica = esTaller ? politicaTalleres : politicaClases;

// Enlace para añadirlo a Google Calendar (hora de España). En las mensuales, el primer día del mes con clase.
const sinSignos = (f: string, h: string) => `${f.replaceAll('-', '')}T${h.replace(':', '')}00`;
const calendario = r.fecha && 'https://calendar.google.com/calendar/render?' + new URLSearchParams({
  action: 'TEMPLATE',
  text: `${r.titulo} · Yutori`,
  dates: `${sinSignos(r.fecha, r.hora_inicio)}/${sinSignos(r.fecha, r.hora_fin)}`,
  ctz: 'Europe/Madrid',
  location: `Yutori Espacio Creativo, ${negocio.direccion}, ${negocio.ciudad}`,
  details: esTaller ? `Taller con ${r.imparte}. ${r.plazas} plaza(s).` : `Clase de ${r.titulo}.`,
});
const volver = esTaller ? `/talleres/${r.slug}` : '/clases';
---
<Base titulo="Tu reserva" noindex>
  <section class="seccion">
    <div class="contenedor reserva">
      {r.estado === 'pendiente' && esMensual && (
        <>
          <p class="script">¡Solicitud recibida!</p>
          <h1>Tu plaza está reservada</h1>
          <div class="tarjeta pago">
            {importe && <p class="pago__importe">{importe}</p>}
            {renovada ? (
              <>
                {r.cobro_error ? <p class="pago__plazo">{textosPago.cobroFallido}</p>
                  : r.metodo_pago === 'tarjeta' ? <p>{textosPago.renovadaTarjeta(r.tarjeta)}</p>
                  : <p>{textosPago.renovadaEfectivo}</p>}
                {eligeMetodo && (
                  <form method="post" class="metodo">
                    <input type="hidden" name="accion" value="metodo" />
                    <fieldset>
                      <legend>{textosPago.formaPago}</legend>
                      {r.stripe_metodo && <label class="casilla"><input type="radio" name="metodo" value="tarjeta" checked={r.metodo_pago === 'tarjeta'} /> {textosPago.tarjeta}</label>}
                      <label class="casilla"><input type="radio" name="metodo" value="efectivo" checked={r.metodo_pago !== 'tarjeta'} /> {textosPago.efectivo}</label>
                    </fieldset>
                    {r.stripe_metodo && <button class="boton boton--borde" type="submit">{textosPago.guardar}</button>}
                  </form>
                )}
              </>
            ) : conTarjeta ? (
              <>
                {vueltaPago ? <p>{textosPago.pagoProcesando}</p> : <p>{textosPago.pendienteTarjeta}</p>}
                {r.caduca_en && <p class="pago__plazo">Tienes hasta el <strong>{fecha(r.caduca_en)}</strong> para pagar. Si no, la plaza se liberará para otra persona.</p>}
              </>
            ) : (
              <>
                <p>Las clases se abonan en el momento de la reserva. Cuando recibamos el pago, tu plaza de <strong>{nombreMes(r.mes!)}</strong> quedará confirmada.</p>
                <p><strong>Cómo pagar:</strong> {comoPagar ?? 'te lo indicaremos por email enseguida.'}</p>
                {comoPagar && <p><strong>Concepto:</strong> {concepto}</p>}
                {r.caduca_en && <p class="pago__plazo">Tienes hasta el <strong>{fecha(r.caduca_en)}</strong> para pagar. Si no, la plaza se liberará para otra persona.</p>}
              </>
            )}
            {puedePagar && (
              <form method="post"><input type="hidden" name="accion" value="pagar" /><button class="boton" type="submit">{textosPago.pagarTarjeta}</button></form>
            )}
          </div>
        </>
      )}
      {r.estado === 'pendiente' && !esMensual && (
        <>
          <p class="script">¡Plaza apartada!</p>
          <h1>Ahora solo falta el pago</h1>
          <div class="tarjeta pago">
            {importe && <p class="pago__importe">{importe}</p>}
            {conTarjeta ? (
              <p>{vueltaPago ? textosPago.pagoProcesando : textosPago.pendienteTarjeta}</p>
            ) : (
              <>
                <p><strong>Cómo pagar:</strong> {comoPagar ?? 'te lo indicaremos por email enseguida.'}</p>
                {comoPagar && <p><strong>Concepto:</strong> {concepto}</p>}
              </>
            )}
            {r.caduca_en && <p class="pago__plazo">Tienes hasta el <strong>{fecha(r.caduca_en)}</strong> para pagar. Si no, la plaza se liberará para otra persona.</p>}
            {puedePagar && (
              <form method="post"><input type="hidden" name="accion" value="pagar" /><button class="boton" type="submit">{textosPago.pagarTarjeta}</button></form>
            )}
          </div>
          {!conTarjeta && <p>Cuando {r.imparte} reciba el pago, tu plaza quedará confirmada. Puedes volver a esta página para comprobarlo: <strong>guárdala en favoritos</strong>.</p>}
        </>
      )}
      {r.estado === 'confirmada' && (
        <>
          <p class="script">¡Nos vemos pronto!</p>
          <h1>Tu {esTaller ? 'reserva' : 'plaza'} está confirmada</h1>
        </>
      )}
      {r.estado === 'liberada' && (
        <>
          <h1>Esta plaza se ha liberado</h1>
          <p>No recibimos el pago a tiempo y la plaza quedó libre para otra persona. Si todavía quieres venir, mira si quedan plazas.</p>
          <a class="boton" href={volver}>Ver plazas</a>
        </>
      )}
      {r.estado === 'cancelada' && (
        <>
          <h1>Esta reserva está cancelada</h1>
          <p>Si crees que es un error, escríbenos por <a href={emailUrl(`Duda sobre mi reserva de ${r.titulo}`)}>email</a> o por <a href={negocio.instagram} rel="noopener" target="_blank">Instagram</a>.</p>
        </>
      )}

      <div class="tarjeta resumen">
        <h2>{r.titulo}</h2>
        <dl class="datos">
          <dt>Cuándo</dt><dd>{cuando}</dd>
          <dt>Dónde</dt><dd>{negocio.direccion}, {negocio.ciudad}</dd>
          {esTaller ? <><dt>Con</dt><dd>{r.imparte}</dd><dt>Plazas</dt><dd>{r.plazas}</dd></> : <><dt>Tipo</dt><dd>{esMensual ? 'Plaza mensual' : 'Clase suelta'}</dd></>}
          {r.modalidad && <><dt>Modalidad</dt><dd>{r.modalidad}</dd></>}
          <dt>A nombre de</dt><dd>{quien}</dd>
        </dl>
        {(r.estado === 'pendiente' || r.estado === 'confirmada') && (
          <div class="botones">
            {calendario && <a class="boton boton--borde" href={calendario} target="_blank" rel="noopener">Añadir a Google Calendar</a>}
            <a class="boton boton--borde" href={negocio.mapsUrl} target="_blank" rel="noopener">Cómo llegar</a>
          </div>
        )}
      </div>

      {avisoBaja && (
        <form method="post" class="tarjeta baja">
          {r.no_renueva ? (
            <>
              <p>{textosPago.noRenovarHecho(mesSiguiente)}</p>
              <input type="hidden" name="accion" value="si_renovar" />
              <button class="boton boton--borde" type="submit">{textosPago.siRenovar}</button>
            </>
          ) : (
            <>
              <p>{textosPago.noRenovarAyuda(mesSiguiente)}</p>
              <input type="hidden" name="accion" value="no_renovar" />
              <button class="boton boton--borde" type="submit">{textosPago.noRenovar}</button>
            </>
          )}
        </form>
      )}

      <details class="politica">
        <summary>¿Necesitas cancelar o cambiar tu plaza?</summary>
        <ul class="lista-politica">{politica.map((p) => <li>{p}</li>)}</ul>
        <p>Para cancelar o ceder tu plaza, escríbenos por <a href={emailUrl(`Cambio en mi reserva de ${r.titulo}`)}>email</a> o por <a href={negocio.instagram} rel="noopener" target="_blank">Instagram</a>.</p>
      </details>
    </div>
  </section>
</Base>

<style>
  .reserva { max-width: 720px; }
  .reserva > .script { font-size: 2rem; margin-bottom: 4px; }
  .pago { border: 2px solid var(--verde); margin: 16px 0; }
  .pago p { margin-bottom: 8px; overflow-wrap: anywhere; }
  .pago__importe { font-family: var(--serif); font-size: 2.2rem; color: var(--verde); margin-bottom: 4px !important; line-height: 1.2; }
  .pago__plazo { color: var(--aviso); }
  .resumen { margin: 24px 0; }
  .resumen h2 { font-size: 1.4rem; }
  .datos { display: grid; grid-template-columns: max-content 1fr; gap: 6px 16px; margin-bottom: 16px; }
  .datos dt { font-weight: 700; color: var(--tinta-suave); }
  .datos dd { margin: 0; }
  @media (max-width: 759px) {
    .datos { grid-template-columns: 1fr; gap: 0; }
    .datos dt { font-size: 0.78rem; margin-top: 10px; }
    .datos dd { font-weight: 600; }
    .resumen .botones { display: grid; gap: 10px; }
    .resumen .botones .boton { justify-content: center; }
  }
  .metodo fieldset { border: 0; padding: 0; margin: 12px 0; }
  .metodo legend { font-weight: 700; margin-bottom: 6px; }
  .baja { margin: 24px 0; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }
  .baja p { margin: 0; max-width: 46ch; }
  .politica summary { cursor: pointer; font-weight: 700; color: var(--verde); }
</style>
