---
import { detallesTalleres } from '../data/yutori';

const iconos: Record<string, string> = {
  'Plazas limitadas': 'M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm8 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM2 19c0-3 3-5 6-5s6 2 6 5M14 14.5c.6-.3 1.3-.5 2-.5 3 0 6 2 6 5',
  'Materiales': 'M14 4l6 6-9 9H5v-6l9-9ZM12 6l6 6',
  'Sin experiencia previa': 'M12 3l2.6 5.4 5.9.8-4.3 4.1 1 5.8L12 16.4 6.8 19.1l1-5.8L3.5 9.2l5.9-.8L12 3Z',
  'Política de reservas y cancelaciones': 'M4 5h16v15H4zM4 9h16M9 3v4M15 3v4M9 14l2 2 4-4',
};
---
<section class="seccion seccion--salvia detalles" id="detalles">
  <div class="contenedor">
    <h2>Antes de reservar</h2>
    <ul class="detalles__lista">
      {detallesTalleres.map((d) => (
        <li class="detalle">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={iconos[d.titulo]} />
          </svg>
          <div>
            <h3>{d.titulo}</h3>
            {Array.isArray(d.texto)
              ? <ul class="detalle__lineas">{d.texto.map((t) => <li>{t}</li>)}</ul>
              : <p>{d.texto}</p>}
            {d.enlace && <p class="detalle__enlace"><a href={d.enlace}>Leer la política completa →</a></p>}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Sin cajas: cuatro columnas separadas por un trazo fino, como una página de cuaderno */
  .detalles__lista { list-style: none; padding: 0; margin: 8px 0 0; display: grid; gap: 28px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); align-items: start; }
  .detalle { display: grid; gap: 14px; align-content: start; padding-top: 20px; border-top: 1px solid color-mix(in srgb, var(--verde) 25%, transparent); }
  .detalle svg { box-sizing: content-box; padding: 12px; border-radius: 50%; background: var(--crema-claro); color: var(--verde-profundo); box-shadow: var(--sombra-suave); }
  .detalle h3 { font-size: 1.25rem; margin-bottom: 6px; }
  .detalle p { margin: 0; color: var(--tinta-suave); }
  .detalle__lineas { margin: 0; padding-left: 1.1em; color: var(--tinta-suave); display: grid; gap: 4px; }
  .detalle__enlace { margin-top: 10px !important; }
  .detalle__enlace a { font-weight: 600; color: var(--verde-profundo); }
</style>
