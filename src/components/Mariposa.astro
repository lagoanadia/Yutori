---
// Logo de Yutori (mariposa con flores), trazado en SVG desde el PNG de Canva.
// size = ancho en px. Decorativo por defecto: el nombre ya aparece en texto al lado.
const { size = 48, class: className = '', alt = '' } = Astro.props;
---
<img class={className} src="/logo.svg" width={size} height={Math.round(size * 1834 / 2372)} alt={alt} />
