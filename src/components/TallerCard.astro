---
import { fechaLarga, duracion } from '../data/yutori';
import { euros } from '../lib/db';
import type { TallerPublico } from '../lib/reservas';

const { taller } = Astro.props as { taller: TallerPublico };
const libres = Math.max(0, taller.plazas - taller.ocupadas);
---
<article class="tarjeta taller">
  {taller.foto
    ? <img class="taller__foto" src={`/fotos/${taller.foto}`} alt={`Taller ${taller.titulo}`} loading="lazy" />
    : <div class="foto-hueco">Foto del taller</div>}
  {taller.es_evento ? <span class="etiqueta">Evento especial</span> : null}
  <h3>{taller.titulo}</h3>
  <p class="taller__quien">con {taller.imparte}</p>
  <p class="taller__cuando">{fechaLarga(taller.fecha)} · {taller.hora_inicio}-{taller.hora_fin}</p>
  <p class="taller__extra">{duracion(taller.hora_inicio, taller.hora_fin)}{taller.materiales && ` · ${taller.materiales}`}</p>
  <div class="taller__pie">
    <span class="taller__precio">{euros(taller.precio_cent)}</span>
    <span class:list={['taller__plazas', { completo: libres === 0 }]}>
      {libres === 0 ? 'Completo' : libres === 1 ? 'Queda 1 plaza' : `Quedan ${libres} plazas`}
    </span>
  </div>
  <a class:list={['boton', { 'boton--borde': libres === 0 }]} href={`/talleres/${taller.slug}`}>{libres === 0 ? 'Ver taller' : 'Reservar plaza'}</a>
</article>

<style>
  .taller { display: flex; flex-direction: column; }
  .taller .etiqueta { align-self: flex-start; }
  .taller__foto { aspect-ratio: 4 / 3; object-fit: cover; border-radius: 12px; margin-bottom: 16px; width: 100%; }
  .taller__quien { color: var(--tinta-suave); margin-bottom: 4px; }
  .taller__cuando { font-weight: 700; margin-bottom: 0; }
  .taller__extra { color: var(--tinta-suave); font-size: 0.95rem; margin-bottom: 8px; }
  .taller__pie { display: flex; justify-content: space-between; align-items: center; margin: auto 0 16px; padding-top: 8px; }
  .taller__precio { font-family: var(--serif); font-size: 1.3rem; color: var(--verde); }
  .taller__plazas { font-weight: 700; font-size: 0.95rem; color: var(--verde); }
  .taller__plazas.completo { color: var(--aviso); }
</style>
