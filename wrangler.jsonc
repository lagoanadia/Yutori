// Configuración de Cloudflare del Worker "yutori".
// El adaptador de Astro añade solo lo demás (punto de entrada, assets, sesiones).
{
  "name": "yutori",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yutori",
      "database_id": "232406db-e2a0-4762-a48a-750d99b9318b",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      // Fotos de propuestas de talleristas y de talleres.
      "binding": "FOTOS",
      "bucket_name": "yutori-fotos"
    }
  ],
  "vars": {
    // Cloudflare Access para /panel. Vacío = el panel no se abre en internet (solo en local).
    "ACCESS_TEAM": "raspy-cherry-af72",
    "ACCESS_AUD": "",
    // Turnstile (anti-spam). La clave secreta va como Secret en Cloudflare: TURNSTILE_SECRET.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFV3R9uyiBT9YNxL",
    // Dirección de la web para los enlaces de los emails y del calendario.
    "SITIO_URL": "https://yutori.lagoanadia.workers.dev",
    // Emails (Resend). Remitente con el dominio de Yutori, p. ej. "Yutori <reservas@dominio.es>". Vacío = no se envían.
    // La clave va como Secret: RESEND_API_KEY.
    "EMAIL_FROM": "",
    // Google Calendar. La clave privada de la cuenta de servicio va como Secret: GOOGLE_SA_KEY.
    "GOOGLE_CALENDAR_ID": "",
    "GOOGLE_SA_EMAIL": "",
    // Cloudflare Web Analytics (sin cookies). Token público del sitio; vacío = sin analítica.
    "CF_ANALYTICS_TOKEN": ""
  }
}
